//! mode7kit world: the one camera both modes build their view around, and
//! the world-coordinate helpers the projections share.
//!
//! Includes `core.r65` and `rotate.r65`; adds no table. A world coordinate
//! is `M7Coord` (core.r65), 10.6 fixed-point texels, so plain u16 arithmetic
//! is the Wrap repeat and `m7k_delta` is the shortest way between two
//! points.
//!
//! `M7Camera` holds the position and heading. `M7K_CAMERA` is the one
//! `M7Static` and the default floor follow, so switching modes keeps the
//! view where it was; a split screen declares one camera per view and
//! passes it to its floor instance (`m7k_floor!`).
//!
//! ```
//! include!("mode7kit/world.r65")
//!
//! M7K_CAMERA.set(M7Coord::from_texel(512), M7Coord::from_texel(512));
//! M7K_CAMERA.turn(2);
//! M7K_CAMERA.forward(128);    // two texels along the heading
//! M7K_CAMERA.strafe(-64);     // one texel to the left
//! ```

include!("mode7kit/core.r65")
include!("mode7kit/rotate.r65")

/// a - b as a signed 10.6 distance: the shortest way round the plane,
/// within ±512 texels.
fn m7k_delta(a: M7Coord, b: M7Coord) -> i16 {
    return (a.0 - b.0) as i16;
}

/// The index of the tile under (x, y) in a 128×128 map, row by row. The
/// game reads its own map with it.
fn m7k_tile_index(x: M7Coord, y: M7Coord) -> u16 {
    return ((y.tile() as u16) << 7) | x.tile() as u16;
}

/// A world camera: the point a view is built around, and the way it faces
/// (256 per turn; 0 looks toward -Y). Declare more as `#[lowram] static
/// mut` for more views.
struct M7Camera {
    x: M7Coord,
    y: M7Coord,
    angle: u8,
}

/// The camera `M7Static` and the default floor follow.
#[lowram]
static mut M7K_CAMERA: M7Camera = M7Camera {
    x: M7Coord(0x8000), y: M7Coord(0x8000), angle: 0,
};

impl M7Camera {
    /// Places the camera.
    fn set(*self, x: M7Coord, y: M7Coord) {
        self.x = x;
        self.y = y;
    }

    /// Where the camera is.
    fn get(*self) -> M7Coord, M7Coord {
        return self.x, self.y;
    }

    /// Faces the camera along `angle`.
    fn set_angle(*self, angle: u8) {
        self.angle = angle;
    }

    /// The heading.
    fn angle(*self) -> u8 {
        return self.angle;
    }

    /// Turns by `d` steps; positive turns the view counterclockwise.
    fn turn(*self, d: i8) {
        self.angle = self.angle + d as u8;
    }

    /// Moves the camera by a 10.6 delta, such as `m7k_heading` gives.
    fn move_by(*self, dx: i16, dy: i16) {
        self.x = self.x + dx as u16;
        self.y = self.y + dy as u16;
    }

    /// Moves `speed` 1/64 texels along the heading (±255); negative moves
    /// back.
    fn forward(*self, speed: i16) {
        self.step(self.angle, speed);
    }

    /// Moves `speed` 1/64 texels across the heading, toward the screen's
    /// right (±255); negative moves left.
    fn strafe(*self, speed: i16) {
        self.step(self.angle - 64, speed);
    }

    /// `speed` along `angle`, the negative way round by a half turn.
    fn step(*self, angle: u8, speed: i16) {
        let mut a: u8 = angle;
        let mut s: i16 = speed;
        if s < 0 {
            a = a + 128;
            s = 0 - s;
        }
        let dx, dy = m7k_heading(a, s as u8);
        self.move_by(dx, dy);
    }
}

/// (x, y) 10.6 minus the whole-texel center (cx, cy) the registers show:
/// sprites then stay locked to the ground, not ahead of it by the fraction
/// the registers drop.
fn m7k_from_center(x: M7Coord, y: M7Coord, cx: u16, cy: u16) -> i16, i16 {
    let dx: i16 = (x.0 - (cx << 6)) as i16;
    let dy: i16 = (y.0 - (cy << 6)) as i16;
    return dx, dy;
}

/// Whether texel `center` plus the 10.6 offset `d` is on the map: always
/// when the plane `wraps`, else within 0..1023.
fn m7k_on_map(wraps: bool, center: u16, d: i16) -> bool {
    if wraps { return true; }
    let t: i16 = (center & 0x3FF) as i16 + (d >> 6);
    return t >= 0 && t < 1024;
}
