//! mode7kit rotation: a compile-time sin/cos table.
//!
//! Includes `core.r65`. Adds `M7K_SINCOS` (640 bytes of ROM), `m7k_sin`,
//! `m7k_cos` and `m7k_heading`, which both modes use. Angles are `u8`, 256
//! steps per turn.
//!
//! ```
//! include!("mode7kit/rotate.r65")
//!
//! let dx, dy = m7k_heading(angle, 64);   // one texel forward, in 10.6
//! ```

include!("mode7kit/core.r65")

const fn m7k_build_sincos() -> [i16; 320] {
    let mut t: [i16; 320] = [0; 320];
    for i in 0..320 {
        t[i] = fixed_sin(i as u16, 256, 256);
    }
    return t;
}

/// sin(2π·i/256)·256 for i in 0..320: `sin(a) = T[a]`, `cos(a) = T[a + 64]`.
static M7K_SINCOS: [i16; 320] = m7k_build_sincos();

/// sin(angle), 8.8 signed.
fn m7k_sin(angle: u8) -> i16 {
    return M7K_SINCOS[angle as u16];
}

/// cos(angle), 8.8 signed.
fn m7k_cos(angle: u8) -> i16 {
    return M7K_SINCOS[angle as u16 + 64];
}

/// One step forward along `angle`, as a 10.6 world delta: `speed` is in
/// 1/64 texel, so 64 moves one texel. Forward is -Y at angle 0, the way the
/// rotation matrix turns the view.
fn m7k_heading(angle: u8, speed: u8) -> i16, i16 {
    let dx: i16 = m7k_smul_q8(0 - m7k_sin(angle), speed as u16);
    let dy: i16 = m7k_smul_q8(0 - m7k_cos(angle), speed as u16);
    return dx, dy;
}
