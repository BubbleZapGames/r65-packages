//! mode7kit transport: one Mode 7 matrix a scanline, by indirect HDMA.
//!
//! Includes `core.r65`. `m7k_hdma!` writes a transport type: the
//! double-buffered per-line matrices, their indirect HDMA tables, M7SEL and
//! the view, and the HDMAEN shadow. It does no math: a floor (`floor.r65`)
//! or the game's own effect fills its rows, and `commit()` shows them.
//!
//! The default instance is `M7HDMA` (state `M7K_HDMA`): 224 lines on
//! channels 2 (M7A/M7B) and 3 (M7C/M7D). A game wanting fewer lines, other
//! channels, or a transport of its own writes its own instance:
//!
//! ```
//! include!("mode7kit/hdma.r65")
//!
//! m7k_hdma!(Wavy, WAVY, 224, 1, 3);     // all 224 lines on channels 1 and 3
//!
//! Wavy::setup(M7Repeat::Wrap, M7Flip::None);   // force blank
//! loop {
//!     wait_nmi!();
//!     let mut l: u8 = 0;
//!     while l < 224 { Wavy::set_line(l, a, b, c, d); l++; }   // line l reads row l
//!     Wavy::set_center(cx, cy, hofs, vofs);
//!     Wavy::publish(0, 224);
//! }
//!
//! #[interrupt(nmi)]
//! fn vblank() { let _shown, _k = Wavy::commit(); }
//! ```

include!("mode7kit/core.r65")

// ============================================================================
// HDMA TABLE WRITERS
// ============================================================================
//
// An HDMA entry starts with a header byte: bit 7 clear is *once* (one unit
// is written on the entry's first line and the register holds it), bit 7
// set is *continuous* (a new unit every line). Bits 0-6 are the line count;
// mode7kit keeps it in 1..127. A 0 header ends the table.

/// Direct-mode once entries holding a one-byte `value` for `lines` lines,
/// split into blocks of at most 127. Returns the new cursor.
fn m7k_hdma_hold(t: far *u8, pos: u16, lines: u8, value: u8) -> u16 {
    let mut p: u16 = pos;
    let mut left: u8 = lines;
    while left > 127 {
        t[p] = 127;
        t[p + 1] = value;
        p = p + 2;
        left = left - 127;
    }
    if left > 0 {
        t[p] = left;
        t[p + 1] = value;
        p = p + 2;
    }
    return p;
}

/// Indirect-mode entries covering `lines` lines from the data at `addr`
/// (same bank as DASBn). A once entry holds the one unit at `addr`; a
/// continuous entry reads `unit` bytes per line, so a block after the first
/// starts 127 units further on. Returns the new cursor.
fn m7k_hdma_ind(t: far *u8, pos: u16, lines: u8, addr: u16, unit: u16, continuous: bool) -> u16 {
    let mut p: u16 = pos;
    let mut left: u8 = lines;
    let mut a: u16 = addr;
    let mut flag: u8 = 0;
    if continuous { flag = 0x80; }
    while left > 0 {
        let mut n: u8 = left;
        if n > 127 { n = 127; }
        t[p] = flag | n;
        t[p + 1] = a as u8;
        t[p + 2] = (a >> 8) as u8;
        p = p + 3;
        if continuous {
            a = a + mul8(n, unit as u8);
        }
        left = left - n;
    }
    return p;
}

/// Ends a table.
fn m7k_hdma_end(t: far *u8, pos: u16) {
    t[pos] = 0;
}

// ============================================================================
// THE TRANSPORT
// ============================================================================

/// One buffer's indirect table, per channel: room for 10 entries and the
/// end (the floor uses at most 4, a split screen 6).
const M7K_IND_BYTES: u16 = 32;

/// `$name`, a transport of `$lines` matrix rows per buffer (at most 224:
/// the most lines of the screen that read their own row) on channels
/// `$ch_ab` (M7A/M7B) and `$ch_cd` (M7C/M7D). Its state, the `#[ram]`
/// static `$state`, takes 16·lines + 151 bytes.
macro_rules! m7k_hdma($name:ident, $state:ident, $lines:expr, $ch_ab:expr, $ch_cd:expr) {
    /// A transport's state. Buffer k's rows start at element k·2·LINES of
    /// `ab` and `cd`: row l's A and B are `ab[base + 2l]` and `[+ 1]`, its C
    /// and D `cd[...]` the same. Buffer k's indirect tables start at byte
    /// k·M7K_IND_BYTES of `abi` and `cdi`.
    struct $name {
        /// M7SEL as the game set it. A floor frame is written without the
        /// vertical bit, which stays set here.
        sel: u8,
        /// M7X/M7Y and BG1HOFS/BG1VOFS for the frame being built,
        /// committed with its tables.
        cx: u16,
        cy: u16,
        hofs: u16,
        vofs: u16,
        /// The buffer being built, and whether it is finished.
        back: u8,
        ready: u8,
        /// HDMAEN shadow: the matrix channels while set up, and the game's.
        hdmaen: u8,
        /// The frame being built is a floor: drop M7SEL's vertical bit.
        floor: bool,
        /// The matrix lines outside the rows hold: the AB unit, then CD.
        top: [i16; 4],
        abi: [u8; 64],
        cdi: [u8; 64],
        ab: [i16; $lines * 4],
        cd: [i16; $lines * 4],
        /// Per buffer, bumped by every write a builder's keys can't see (a
        /// custom `publish`, `setup`): a builder keyed on it rebuilds.
        stamp: [u8; 2],
    }

    #[ram]
    static mut $state: $name = $name {
        sel: 0, cx: 0, cy: 0, hofs: 0, vofs: 0,
        back: 0, ready: 0, hdmaen: 0, floor: false,
        top: [0x100, 0, 0, 0x100],
        abi: [0; 64], cdi: [0; 64],
        ab: [0; $lines * 4], cd: [0; $lines * 4],
        stamp: [0, 0],
    };

    impl $name {
        /// The matrix rows, from the top of the screen.
        const LINES: u16 = $lines;

        /// BGMODE 7 and M7SEL; configures the two channels, fills both
        /// buffers with the top matrix so the first frames are valid, and
        /// adds the channels to the HDMAEN shadow. Force blank, or vblank
        /// when switching modes.
        fn setup(repeat: M7Repeat, flip: M7Flip) {
            BGMODE = 0x07;
            $state.sel = repeat as u8 | flip as u8;
            M7SEL = $state.sel;
            M7K_DMA[$ch_ab].dmap = 0x43;           // indirect, two write-twice registers
            M7K_DMA[$ch_ab].bbad = 0x1B;           // M7A, M7B
            M7K_DMA[$ch_ab].a1t = &$state.abi as u16;
            M7K_DMA[$ch_ab].a1b = M7K_RAM_BANK;
            M7K_DMA[$ch_ab].dasb = M7K_RAM_BANK;   // the rows' bank
            M7K_DMA[$ch_cd].dmap = 0x43;
            M7K_DMA[$ch_cd].bbad = 0x1D;           // M7C, M7D
            M7K_DMA[$ch_cd].a1t = &$state.cdi as u16;
            M7K_DMA[$ch_cd].a1b = M7K_RAM_BANK;
            M7K_DMA[$ch_cd].dasb = M7K_RAM_BANK;
            $state.back = 0;
            let p: u16 = $name::seg_top(0, 224);
            $name::finish(p, false);
            $state.back = 1;
            let q: u16 = $name::seg_top(0, 224);
            $name::finish(q, false);
            $state.ready = 0;
            $state.stamp[0] = $state.stamp[0] + 1;
            $state.stamp[1] = $state.stamp[1] + 1;
            $state.hdmaen = $state.hdmaen | (1 << $ch_ab) | (1 << $ch_cd);
        }

        /// Takes the matrix channels out of the shadow and writes HDMAEN
        /// at once, as the handler no longer commits. In vblank.
        fn stop() {
            $state.hdmaen = $state.hdmaen & ~((1 << $ch_ab) | (1 << $ch_cd));
            $state.ready = 0;
            HDMAEN = $state.hdmaen;
        }

        /// Shows the frame `finish` ended, from the NMI handler: points the
        /// channels at its tables, flips, and writes M7SEL (without the
        /// vertical bit for a floor), the center and the scroll. A frame
        /// not finished keeps the old one whole. Always writes HDMAEN; never
        /// M7A-D. Returns whether it flipped and the buffer now shown: an
        /// add-on that flipped points its own channels at that buffer.
        fn commit() -> bool, u8 {
            if $state.ready != 0 {
                let k: u8 = $state.back;
                let off: u16 = (k as u16) << 5;
                M7K_DMA[$ch_ab].a1t = (&$state.abi as u16) + off;
                M7K_DMA[$ch_cd].a1t = (&$state.cdi as u16) + off;
                $state.back = k ^ 1;
                $state.ready = 0;
                let mut sel: u8 = $state.sel;
                if $state.floor { sel = sel & 0xFD; }
                m7k_write_view(sel, $state.cx, $state.cy, $state.hofs, $state.vofs);
                HDMAEN = $state.hdmaen;
                return true, k;
            }
            HDMAEN = $state.hdmaen;
            return false, $state.back ^ 1;
        }

        /// M7SEL as set (`M7Repeat as u8 | M7Flip as u8`).
        fn sel() -> u8 {
            return $state.sel;
        }

        fn set_sel(sel: u8) {
            $state.sel = sel;
        }

        /// Adds the game's own HDMA channels to the HDMAEN shadow.
        fn enable(mask: u8) {
            $state.hdmaen = $state.hdmaen | mask;
        }

        /// Removes HDMAEN bits from the shadow.
        fn disable(mask: u8) {
            $state.hdmaen = $state.hdmaen & ~mask;
        }

        // -- the per-line layer -------------------------------------------

        /// The buffer being built, 0 or 1.
        fn back_index() -> u8 {
            return $state.back;
        }

        /// The back buffer's first element in `ab` / `cd` (0 or 2·LINES):
        /// row l's A and B are `$state.ab[back() + 2l]` and `[+ 1]`, its C
        /// and D `$state.cd[...]` the same.
        fn back() -> u16 {
            if $state.back != 0 { return $lines * 2; }
            return 0;
        }

        /// The back buffer's stamp, for a builder's keys.
        fn stamp() -> u8 {
            return $state.stamp[$state.back as u16];
        }

        /// Row `row` of the back buffer.
        fn set_line(row: u8, a: i16, b: i16, c: i16, d: i16) {
            let k: u16 = $name::back() + ((row as u16) << 1);
            $state.ab[k] = a;
            $state.ab[k + 1] = b;
            $state.cd[k] = c;
            $state.cd[k + 1] = d;
        }

        /// The matrix the lines outside the rows hold (the identity unless
        /// set).
        fn set_top(a: i16, b: i16, c: i16, d: i16) {
            $state.top[0] = a;
            $state.top[1] = b;
            $state.top[2] = c;
            $state.top[3] = d;
        }

        /// The center (texels) and the scroll for the frame being built.
        fn set_center(cx: u16, cy: u16, hofs: u16, vofs: u16) {
            $state.cx = cx;
            $state.cy = cy;
            $state.hofs = hofs;
            $state.vofs = vofs;
        }

        /// Finishes a custom frame: lines 0..top hold the top matrix, line
        /// `top + r` reads row r for `rows` lines, and the matrix channels
        /// stop after them (for a band below in another mode). The last
        /// step; `commit` shows it next vblank.
        fn publish(top: u8, rows: u8) {
            let p: u16 = $name::seg_top(0, top);
            let q: u16 = $name::seg_rows(p, 0, rows);
            $state.stamp[$state.back as u16] = $state.stamp[$state.back as u16] + 1;
            $name::finish(q, false);
        }

        /// Starts the back buffer's tables, for a frame of several bands:
        /// the first segment's cursor.
        fn begin() -> u16 {
            return 0;
        }

        /// A segment of `lines` lines holding the top matrix. Returns the
        /// next cursor.
        fn seg_top(p: u16, lines: u8) -> u16 {
            let base: u16 = ($state.back as u16) << 5;
            let ident: u16 = &$state.top as u16;
            m7k_hdma_ind(&$state.abi as far *u8, base + p, lines, ident, 4, false);
            let q: u16 = m7k_hdma_ind(&$state.cdi as far *u8, base + p, lines, ident + 4, 4, false);
            return q - base;
        }

        /// A segment of `lines` lines reading rows `row`, `row + 1`...
        /// Returns the next cursor.
        fn seg_rows(p: u16, row: u8, lines: u8) -> u16 {
            let base: u16 = ($state.back as u16) << 5;
            let row: u16 = ($name::back() + ((row as u16) << 1)) << 1;
            let ab: u16 = (&$state.ab as u16) + row;
            let cd: u16 = (&$state.cd as u16) + row;
            m7k_hdma_ind(&$state.abi as far *u8, base + p, lines, ab, 4, true);
            let q: u16 = m7k_hdma_ind(&$state.cdi as far *u8, base + p, lines, cd, 4, true);
            return q - base;
        }

        /// Ends the back buffer's tables at cursor `p` and marks it ready.
        /// `floor`: written without M7SEL's vertical bit.
        fn finish(p: u16, floor: bool) {
            let base: u16 = ($state.back as u16) << 5;
            m7k_hdma_end(&$state.abi as far *u8, base + p);
            m7k_hdma_end(&$state.cdi as far *u8, base + p);
            $state.floor = floor;
            $state.ready = 1;
        }

        /// Marks the back buffer ready with the tables it holds: for a
        /// builder whose keys say they are the ones it would write.
        fn finish_same(floor: bool) {
            $state.floor = floor;
            $state.ready = 1;
        }
    }
}

// The default transport: all 224 lines, channels 2 and 3.
m7k_hdma!(M7HDMA, M7K_HDMA, 224, 2, 3);
