//! mode7kit core: the `Mode7` trait every view implements, and the pieces
//! the views share.
//!
//! A game picks a view by the type it uses: `M7Static` (`static.r65`), one
//! matrix a frame; or, one matrix a scanline by HDMA, the perspective
//! floor `M7Plain` (`plain.r65`) or the true-pitch plain `M7PlainRotation`
//! (`plain_rotation.r65`). Each implements `Mode7`, so a game's loop and
//! sprite code read the same in any.
//!
//! This file holds:
//! - the `Mode7` trait, and `Mode7Scan`, the per-line views' trait, with
//!   the macros the per-line views share their bodies through;
//! - the M7SEL enums, the world coordinate `M7Coord` and its helpers;
//! - the camera type, `M7Camera`. The game declares its cameras and hands
//!   one to each view's `setup`;
//! - the tables: sin/cos (640 B), the zoom reciprocal (512 B) and the
//!   per-line views' depth scale (2321 B), each dropped when unused;
//! - two stateless register writers, the DMA channel array, the
//!   fixed-point multiplies and the VRAM upload macros.
//!
//! The per-line views' transport, `m7k_hdma!`, and its default instance
//! `M7HDMA` are in `hdma.r65`.
//!
//! A flat view:
//!
//! ```
//! include!("mode7kit/static.r65")
//!
//! #[lowram]
//! static mut CAMERA: M7Camera = M7Camera {
//!     x: M7Coord(0x8000), y: M7Coord(0x8000), heading: 0, height: 64, pitch: 0,
//! };
//!
//! M7Static::setup(&CAMERA, M7Repeat::Wrap, M7Flip::None);   // force blank
//! loop {
//!     wait_nmi!();
//!     CAMERA.turn(1);
//!     M7Static::update();
//!     let sx, sy, size = M7Static::to_screen(enemy_x, enemy_y);
//! }
//!
//! #[interrupt(nmi)]
//! fn vblank() { M7Static::nmi(); }
//! ```
//!
//! See DESIGN.md for the math and the cost model.

include!("stdlib/sneslib.r65")
include!("stdlib/math.r65")

// ============================================================================
// M7SEL
// ============================================================================

/// What the plane shows beyond its 1024×1024 texels (M7SEL bits 6-7).
enum M7Repeat {
    /// The whole 128×128 tilemap repeats forever in every direction.
    Wrap = 0x00,
    /// Nothing is drawn outside the map: the backdrop or a lower layer shows.
    Transparent = 0x80,
    /// Outside the map, tile 0's pattern repeats and the tilemap does not.
    Tile0 = 0xC0,
}

impl M7Repeat {
    /// True only for `Wrap`: the plane is a torus, so world coordinates
    /// wrap and every point is on the map.
    fn wraps(self) -> bool {
        return self as u8 == 0;
    }
}

/// Reflection of the screen (M7SEL bits 0-1). The hardware mirrors the
/// screen coordinate before the matrix applies: Sx becomes 255 - Sx, Sy
/// becomes 255 - Sy.
enum M7Flip {
    None = 0x00,
    Horizontal = 0x01,
    Vertical = 0x02,
    Both = 0x03,
}

impl M7Flip {
    /// True for `Horizontal` and `Both`.
    fn horizontal(self) -> bool {
        return self as u8 & 0x01 != 0;
    }

    /// True for `Vertical` and `Both`.
    fn vertical(self) -> bool {
        return self as u8 & 0x02 != 0;
    }

    /// The reflection with the horizontal axis switched.
    fn toggle_h(self) -> M7Flip {
        match self {
            M7Flip::None => M7Flip::Horizontal,
            M7Flip::Horizontal => M7Flip::None,
            M7Flip::Vertical => M7Flip::Both,
            M7Flip::Both => M7Flip::Vertical,
        }
    }

    /// The reflection with the vertical axis switched.
    fn toggle_v(self) -> M7Flip {
        match self {
            M7Flip::None => M7Flip::Vertical,
            M7Flip::Vertical => M7Flip::None,
            M7Flip::Horizontal => M7Flip::Both,
            M7Flip::Both => M7Flip::Horizontal,
        }
    }
}

// ============================================================================
// WORLD COORDINATES
// ============================================================================

/// A world coordinate: 10.6 fixed-point texels. `>> 6` is the texel,
/// `>> 9` the tile. The plane is 1024 texels, exactly 65536 sixty-fourths,
/// so it wraps by u16 overflow.
struct M7Coord(u16);

impl M7Coord {
    /// The coordinate of texel `t`.
    fn from_texel(t: u16) -> M7Coord {
        return M7Coord(t << 6);
    }

    /// The texel, 0..1023.
    fn texel(self) -> u16 {
        return (self.0 >> 6) & 0x3FF;
    }

    /// The tile, 0..127.
    fn tile(self) -> u8 {
        return (self.0 >> 9) as u8 & 0x7F;
    }
}

/// a - b as a signed 10.6 distance: the shortest way round the plane,
/// within ±512 texels.
fn m7k_delta(a: M7Coord, b: M7Coord) -> i16 {
    return (a.0 - b.0) as i16;
}

/// The index of the tile under (x, y) in a 128×128 map, row by row. The
/// game reads its own map with it.
fn m7k_tile_index(x: M7Coord, y: M7Coord) -> u16 {
    return ((y.tile() as u16) << 7) | x.tile() as u16;
}

// ============================================================================
// SIN AND COS
// ============================================================================

// Angles are `u8`, 256 steps per turn. `M7K_SINCOS` is 640 bytes of ROM,
// dropped from a program that never turns.

const fn m7k_build_sincos() -> [i16; 320] {
    let mut t: [i16; 320] = [0; 320];
    for i in 0..320 {
        t[i] = fixed_sin(i as u16, 256, 256);
    }
    return t;
}

/// sin(2π·i/256)·256 for i in 0..320: `sin(a) = T[a]`, `cos(a) = T[a + 64]`.
static M7K_SINCOS: [i16; 320] = m7k_build_sincos();

/// sin(angle), 8.8 signed.
fn m7k_sin(angle: u8) -> i16 {
    return M7K_SINCOS[angle as u16];
}

/// cos(angle), 8.8 signed.
fn m7k_cos(angle: u8) -> i16 {
    return M7K_SINCOS[angle as u16 + 64];
}

/// One step forward along `angle`, as a 10.6 world delta: `speed` is in
/// 1/64 texel, so 64 moves one texel. Forward is -Y at angle 0, the way the
/// rotation matrix turns the view.
fn m7k_heading(angle: u8, speed: u8) -> i16, i16 {
    let dx: i16 = m7k_smul_q8(0 - m7k_sin(angle), speed as u16);
    let dy: i16 = m7k_smul_q8(0 - m7k_cos(angle), speed as u16);
    return dx, dy;
}

// ============================================================================
// ZOOM
// ============================================================================

// A zoom is a `u8` per screen axis: 64 is 1.0×, 128 magnifies 2×, 16
// shrinks to ¼×. Zoom is linear in on-screen size, so stepping it by one a
// frame zooms smoothly. `M7K_RECIP` is 512 bytes of ROM, dropped from a
// program that never scales.

const fn m7k_build_recip() -> [u16; 256] {
    let mut t: [u16; 256] = [0; 256];
    t[0] = 0x7FFF;
    for z in 1..256 {
        t[z] = 16384 / (z as u16);
    }
    return t;
}

/// 16384 / zoom: texels per screen pixel (8.8) at that zoom.
static M7K_RECIP: [u16; 256] = m7k_build_recip();

/// Texels per screen pixel at `zoom`, 8.8.
fn m7k_recip(zoom: u8) -> u16 {
    return M7K_RECIP[zoom as u16];
}

// ============================================================================
// THE CAMERA
// ============================================================================

/// The range of `M7Camera::pitch`, which `tilt` keeps it in.
const M7K_PITCH_MIN: i8 = -32;
const M7K_PITCH_MAX: i8 = 64;

/// A world camera: the point a view is built around, the way it faces
/// (256 per turn; 0 looks toward -Y), its height and its pitch. The game
/// declares its cameras, as `#[lowram] static mut` (a view keeps a near
/// pointer), and gives each view one at its `setup`; `set_camera` changes
/// it later. Two views may share one.
///
/// Each view reads the height and the pitch its own way: `M7Plain` takes
/// the pitch as its horizon shift in scanlines (positive looks up),
/// `M7PlainRotation` as an angle (0 level, 64 straight down). `M7Static`
/// reads neither.
struct M7Camera {
    /// Where it stands on the plane.
    x: M7Coord,
    y: M7Coord,
    /// The heading: 256 a turn, 0 looks toward -Y.
    heading: u8,
    /// Height above the plane, 0..127.
    height: u8,
    /// Pitch, `M7K_PITCH_MIN..M7K_PITCH_MAX`.
    pitch: i8,
}

impl M7Camera {
    /// Places the camera.
    fn set(*self, x: M7Coord, y: M7Coord) {
        self.x = x;
        self.y = y;
    }

    /// Where the camera is.
    fn get(*self) -> M7Coord, M7Coord {
        return self.x, self.y;
    }

    /// Faces the camera along heading `h`.
    fn set_heading(*self, h: u8) {
        self.heading = h;
    }

    /// The heading.
    fn heading(*self) -> u8 {
        return self.heading;
    }

    /// Turns by `d` steps; positive turns the view counterclockwise.
    fn turn(*self, d: i8) {
        self.heading = self.heading + d as u8;
    }

    /// Sets the height above the plane, 0..127 (a view clamps higher).
    fn set_height(*self, h: u8) {
        self.height = h;
    }

    /// The height above the plane.
    fn height(*self) -> u8 {
        return self.height;
    }

    /// Sets the pitch, `M7K_PITCH_MIN..M7K_PITCH_MAX` (a view clamps it to
    /// its own range).
    fn set_pitch(*self, p: i8) {
        self.pitch = p;
    }

    /// The pitch.
    fn pitch(*self) -> i8 {
        return self.pitch;
    }

    /// Adds `d` to the pitch, kept in `M7K_PITCH_MIN..M7K_PITCH_MAX`.
    fn tilt(*self, d: i8) {
        let mut p: i16 = self.pitch as i16 + d as i16;
        if p < M7K_PITCH_MIN as i16 { p = M7K_PITCH_MIN as i16; }
        if p > M7K_PITCH_MAX as i16 { p = M7K_PITCH_MAX as i16; }
        self.pitch = p as i8;
    }

    /// Moves the camera by a 10.6 delta, such as `m7k_heading` gives.
    fn move_by(*self, dx: i16, dy: i16) {
        self.x = self.x + dx as u16;
        self.y = self.y + dy as u16;
    }

    /// Moves `speed` 1/64 texels along the heading (±255); negative moves
    /// back.
    fn forward(*self, speed: i16) {
        self.step(self.heading, speed);
    }

    /// Moves `speed` 1/64 texels across the heading, toward the screen's
    /// right (±255); negative moves left.
    fn strafe(*self, speed: i16) {
        self.step(self.heading - 64, speed);
    }

    /// `speed` along `angle`, the negative way round by a half turn.
    fn step(*self, angle: u8, speed: i16) {
        let mut a: u8 = angle;
        let mut s: i16 = speed;
        if s < 0 {
            a = a + 128;
            s = 0 - s;
        }
        let dx, dy = m7k_heading(a, s as u8);
        self.move_by(dx, dy);
    }
}

// ============================================================================
// PROJECTION HELPERS
// ============================================================================

/// (x, y) 10.6 minus the whole-texel center (cx, cy) the registers show:
/// sprites then stay locked to the ground, not ahead of it by the fraction
/// the registers drop.
fn m7k_from_center(x: M7Coord, y: M7Coord, cx: u16, cy: u16) -> i16, i16 {
    let dx: i16 = (x.0 - (cx << 6)) as i16;
    let dy: i16 = (y.0 - (cy << 6)) as i16;
    return dx, dy;
}

/// Whether texel `center` plus the 10.6 offset `d` is on the map: always
/// when the plane `wraps`, else within 0..1023.
fn m7k_on_map(wraps: bool, center: u16, d: i16) -> bool {
    if wraps { return true; }
    let t: i16 = (center & 0x3FF) as i16 + (d >> 6);
    return t >= 0 && t < 1024;
}

// ============================================================================
// THE TRAIT
// ============================================================================

/// `to_screen`'s sy for a point that can't be drawn: behind the camera,
/// past the horizon, or below the screen or the view's band.
const M7K_HIDDEN: i16 = 0x7FFF;

/// Screen center, the usual pivot.
const M7_CENTER_X: u8 = 128;
const M7_CENTER_Y: u8 = 112;

/// A Mode 7 view: one implementor per way of feeding M7A-D (`M7Static`,
/// `M7Plain`, `M7PlainRotation`, a game's own). Every method is an
/// associated function on the implementing type (`M7Static::nmi()`),
/// dispatched statically; each implementor keeps its own state.
trait Mode7 {
    /// BGMODE 7, M7SEL, and the implementor's own hardware, following
    /// camera `cam` (the game's). Force blank, or vblank when switching
    /// modes.
    fn setup(cam: *M7Camera, repeat: M7Repeat, flip: M7Flip);

    /// The camera `update` builds from, from then on, in place of the one
    /// `setup` took. The view keeps the pointer, not a copy: moving the
    /// camera moves the view.
    fn set_camera(cam: *M7Camera);

    /// The camera `update` builds from.
    fn camera() -> *M7Camera;

    /// Builds the next frame from the camera and the type's properties.
    fn update();

    /// Commits the built frame. Call from the NMI handler.
    fn nmi();

    /// The screen pixel showing world point (x, y), and the on-screen size
    /// of one texel there (8.8 pixels). sy is `M7K_HIDDEN` for a point that
    /// can't be drawn.
    fn to_screen(x: M7Coord, y: M7Coord) -> i16, i16, u16;

    /// The world point under screen pixel (sx, sy). The `bool` is false off
    /// the map under a repeat mode that doesn't wrap, or off the plane.
    fn to_world(sx: i16, sy: i16) -> bool, M7Coord, M7Coord;

    /// The implementor's M7SEL value (`M7Repeat as u8 | M7Flip as u8`),
    /// for the methods below.
    fn sel() -> u8;
    fn set_sel(sel: u8);

    /// Changes what is drawn beyond the map, keeping the reflection.
    fn set_repeat(repeat: M7Repeat) {
        Self::set_sel((Self::sel() & 0x03) | repeat as u8);
    }

    /// Changes the reflection, keeping the repeat mode.
    fn set_flip(flip: M7Flip) {
        Self::set_sel((Self::sel() & 0xC0) | flip as u8);
    }

    /// The current repeat mode.
    fn repeat() -> M7Repeat {
        return (Self::sel() & 0xC0) as M7Repeat;
    }

    /// The current reflection.
    fn flip() -> M7Flip {
        return (Self::sel() & 0x03) as M7Flip;
    }
}

// ============================================================================
// THE SCAN TRAIT
// ============================================================================

/// A `Mode7` view built a scanline at a time into a transport: the floor
/// (`m7k_plain!`), the true-pitch plain (`m7k_plain_rotation!`) or a
/// game's own per-line effect. A build renders rows
/// into a region of lines, `begin()..end()`; the lines above it, down from
/// the build's `top`, show the transport's top matrix. A game stacks
/// these by their regions through these methods alone: the flyer example
/// puts a sky band over the lines above a floor's region, and the split
/// example builds two floors into one frame.
trait Mode7Scan: Mode7 {
    /// Builds `lines` lines from screen line `top` into the transport's
    /// back buffer, without publishing: the rows, the center and the
    /// scroll. A game building several into one frame calls this for each,
    /// then lays out the segments itself.
    fn build(top: u8, lines: u8);

    /// Publishes the last full-screen `build` as the transport's next
    /// frame.
    fn publish();

    /// The transport's `commit()`, for an NMI handler that shows add-ons
    /// with the frame: whether it flipped, and the buffer now shown.
    fn commit() -> bool, u8;

    /// The first screen line the last build rendered rows into.
    fn begin() -> u8;

    /// One past the last screen line the last build rendered rows into:
    /// the region is `begin()..end()`, empty when they are equal.
    fn end() -> u8;

    /// Appends the last build's region, lines `begin()..end()`, to the back
    /// buffer's tables at cursor `p` (after the segments above it), and
    /// returns the next cursor. A game laying out several views in one
    /// frame calls it for each, instead of naming the rows itself.
    fn segment(p: u16) -> u16;

    /// The last build's center (M7X, M7Y), in texels.
    fn center() -> u16, u16;

    /// The last build's BG1 scroll (M7HOFS, M7VOFS).
    fn scroll() -> u16, u16;
}

// ============================================================================
// SCAN VIEW HELPERS
// ============================================================================
//
// The bodies `M7Plain` and `M7PlainRotation` share, as macros each
// instance expands in its own functions, so the code stays the instance's,
// with its state's absolute addresses. A scan view's state has the fields
// they name: `top`, `sky`, `ground` (the last build's band), `pivot` (the
// screen line the matrix pivots on), `sin`, `cos`, `depth`, `cx`,
// `cy`, `hofs`, `vofs`, `line_z` (`u8`), `line_dist` (`i16`, falling from the
// horizon down, but for a texel of the 8-bit z's rounding), `reach` (the
// cull distance, texels), `gen` (bumped by a table rebuild), `camera`,
// and per transport buffer the keys `key_angle`, `key_gen`, `key_top`,
// `key_rows`, `key_stamp`, `key_sky`, `key_ground`, `key_tstamp` and
// `key_tgen`. Their locals are prefixed `m7k_`: R65 macros have no hygiene.

/// `to_screen`'s body for scan view state `$state` on transport state
/// `$hstate`: world point (`$x`, `$y`) to (sx, sy, texel size), or sy
/// `M7K_HIDDEN`. It returns from the function it is expanded in.
macro_rules! m7k_scan_to_screen($state:ident, $hstate:ident, $x:expr, $y:expr) {
    let m7k_dx, m7k_dy = m7k_from_center($x, $y, $state.cx, $state.cy);
    $state.depth = 0;
    let m7k_ground: u16 = $state.ground as u16;
    if m7k_ground == 0 {
        return 0, M7K_HIDDEN, 0;
    }
    // Farther than `reach` on either axis (texels) is off the view: no
    // multiply.
    let m7k_reach: u16 = $state.reach;
    let _m7k_xn, m7k_ax = m7k_abs(m7k_dx);
    let _m7k_yn, m7k_ay = m7k_abs(m7k_dy);
    if (m7k_ax >> 6) > m7k_reach || (m7k_ay >> 6) > m7k_reach {
        return 0, M7K_HIDDEN, 0;
    }
    // view space, texels: forward = (-sin, -cos), right = (cos, -sin)
    let m7k_f, m7k_r = m7k_rotate14($state.sin, $state.cos, m7k_dx, m7k_dy);
    $state.depth = m7k_f;
    if m7k_f > $state.line_dist[0] || m7k_f < $state.line_dist[m7k_ground - 1] {
        return 0, M7K_HIDDEN, 0;
    }
    // the line whose distance is nearest below f: line_dist falls
    let mut m7k_lo: u16 = 0;
    let mut m7k_hi: u16 = m7k_ground - 1;
    while m7k_lo < m7k_hi {
        let m7k_mid: u16 = (m7k_lo + m7k_hi) >> 1;
        if $state.line_dist[m7k_mid] > m7k_f { m7k_lo = m7k_mid + 1; } else { m7k_hi = m7k_mid; }
    }
    let m7k_size: u16 = m7k_recip($state.line_z[m7k_lo] as u8);
    let m7k_rn, m7k_rm = m7k_abs(m7k_r);
    let m7k_olo, m7k_ohi = mul16_wide(m7k_rm, m7k_size);
    let mut m7k_off: i16 = ((m7k_ohi << 8) | (m7k_olo >> 8)) as i16;
    if m7k_rn { m7k_off = 0 - m7k_off; }
    let mut m7k_sx: i16 = 128 + m7k_off;
    if $hstate.sel & 0x01 != 0 { m7k_sx = 255 - m7k_sx; }
    return m7k_sx, ($state.sky as u16 + m7k_lo) as i16, m7k_size;
}

/// The heading, rows and view of a scan view's build, once its band (`top`,
/// `sky`, `ground`) and its `pivot` are set: the back buffer's `$n` rows
/// from row `$top`, by row builder `$rows`, unless its keys say they are
/// there; then the center on camera `$cam` and the scroll.
macro_rules! m7k_scan_build_rows($state:ident, $hdma:ident, $hstate:ident, $rows:ident, $cam:ident, $top:ident, $n:expr) {
    let m7k_angle: u8 = $cam.heading;
    let m7k_s: i16 = m7k_sin(m7k_angle);
    let m7k_c: i16 = m7k_cos(m7k_angle);
    $state.sin = m7k_s;
    $state.cos = m7k_c;
    let m7k_kb: u16 = $hdma::back_index() as u16;
    let m7k_nrows: u8 = $n;
    let m7k_gen: u8 = $state.gen;
    let m7k_stamp: u8 = $hdma::stamp();
    if $state.key_gen[m7k_kb] != m7k_gen || $state.key_angle[m7k_kb] != m7k_angle
        || $state.key_top[m7k_kb] != $top || $state.key_stamp[m7k_kb] != m7k_stamp
        || $state.key_rows[m7k_kb] < m7k_nrows {
        let m7k_neg_c, m7k_abs_c = m7k_abs(m7k_c);
        let m7k_neg_s, m7k_abs_s = m7k_abs(m7k_s);
        $rows!($hstate, $state, $hdma::back() + (($top as u16) << 1),
               m7k_nrows as u16, m7k_abs_c, m7k_abs_s, m7k_neg_c, m7k_neg_s);
        $state.key_gen[m7k_kb] = m7k_gen;
        $state.key_angle[m7k_kb] = m7k_angle;
        $state.key_top[m7k_kb] = $top;
        $state.key_stamp[m7k_kb] = m7k_stamp;
        $state.key_rows[m7k_kb] = m7k_nrows;
    }
    // Center on the camera; the vertical term crosses zero on the pivot.
    let m7k_cx: u16 = $cam.x.texel();
    let m7k_cy: u16 = $cam.y.texel();
    $state.cx = m7k_cx;
    $state.cy = m7k_cy;
    $state.hofs = m7k_cx - 128;
    $state.vofs = m7k_cy - $state.pivot;
}

/// `publish`'s body for scan view `$name` (state `$state`) on transport
/// `$hdma`: the top matrix down to the horizon, then the view's own
/// `segment`, unless the back buffer's tables already hold that layout.
macro_rules! m7k_scan_publish($name:ident, $state:ident, $hdma:ident) {
    $hdma::set_center($state.cx, $state.cy, $state.hofs, $state.vofs);
    let m7k_kb: u16 = $hdma::back_index() as u16;
    let m7k_sky: u8 = $state.sky;
    let m7k_ground: u8 = $state.ground;
    let m7k_stamp: u8 = $hdma::stamp();
    let m7k_gen: u8 = $state.gen;
    if $state.key_sky[m7k_kb] == m7k_sky && $state.key_ground[m7k_kb] == m7k_ground
        && $state.key_tstamp[m7k_kb] == m7k_stamp && $state.key_tgen[m7k_kb] == m7k_gen {
        $hdma::finish_same(true);
    } else {
        let m7k_p: u16 = $hdma::seg_top(0, m7k_sky);
        let m7k_q: u16 = $name::segment(m7k_p);
        $hdma::finish(m7k_q, true);
        $state.key_sky[m7k_kb] = m7k_sky;
        $state.key_ground[m7k_kb] = m7k_ground;
        $state.key_tstamp[m7k_kb] = m7k_stamp;
        $state.key_tgen[m7k_kb] = m7k_gen;
    }
}

// ============================================================================
// REGISTER WRITERS
// ============================================================================

/// M7A..M7D, write-twice. In vblank.
fn m7k_write_matrix(a: i16, b: i16, c: i16, d: i16) {
    let ua: u16 = a as u16;
    M7A = ua as u8;
    M7A = (ua >> 8) as u8;
    let ub: u16 = b as u16;
    M7B = ub as u8;
    M7B = (ub >> 8) as u8;
    let uc: u16 = c as u16;
    M7C = uc as u8;
    M7C = (uc >> 8) as u8;
    let ud: u16 = d as u16;
    M7D = ud as u8;
    M7D = (ud >> 8) as u8;
}

/// M7SEL, the M7X/M7Y center and the BG1 scroll (M7HOFS/M7VOFS). In vblank.
fn m7k_write_view(sel: u8, cx: u16, cy: u16, hofs: u16, vofs: u16) {
    M7SEL = sel;
    M7X = cx as u8;
    M7X = (cx >> 8) as u8;
    M7Y = cy as u8;
    M7Y = (cy >> 8) as u8;
    BG1HOFS = hofs as u8;
    BG1HOFS = (hofs >> 8) as u8;
    BG1VOFS = vofs as u8;
    BG1VOFS = (vofs >> 8) as u8;
}

// ============================================================================
// DMA CHANNELS BY NUMBER
// ============================================================================

/// One DMA channel's registers, $43n0..$43nF.
struct M7KChannel {
    /// DMAPn: the transfer mode (direct or indirect, which registers).
    dmap: u8,
    /// BBADn: the PPU register, as $21xx's low byte.
    bbad: u8,
    /// A1Tn, A1Bn: the table's address and bank.
    a1t: u16,
    a1b: u8,
    /// DASn, DASBn: indirect HDMA's data address and bank.
    das: u16,
    dasb: u8,
    /// A2An, NTRLn: the channel's place in its table, kept by the hardware.
    a2a: u16,
    ntrl: u8,
    unused: [u8; 5],
}

/// The eight channels. A constant index folds to one absolute store
/// (`M7K_DMA[3].a1t` is $4332), so an instance macro's channel numbers cost
/// nothing at run time.
#[hw(0x4300)]
static mut M7K_DMA: [M7KChannel; 8];

/// The bank of every `#[ram]` static: they are linked under `.BASE $7E`
/// (pinned by R65's tests/e2e/test_bank_byte_macros.py). Low RAM tables
/// are bank 0.
const M7K_RAM_BANK: u8 = 0x7E;

// ============================================================================
// FIXED-POINT HELPERS
// ============================================================================

/// Whether v is negative, and |v| as u16.
fn m7k_abs(v: i16) -> bool, u16 {
    if v < 0 {
        return true, (0 - v) as u16;
    }
    return false, v as u16;
}

/// (m · k) >> 8 for m ≤ 256 and any u16 k, saturating at 0x7FFF. Two 8×8
/// hardware multiplies: the high byte of k times m, plus the carry from
/// its low byte.
fn m7k_mul_q8(m: u16, k: u16) -> u16 {
    if m >= 256 {
        if k > 0x7FFF { return 0x7FFF; }
        return k;
    }
    let lo: u16 = mul8(m as u8, k as u8) >> 8;
    let hi: u16 = mul8(m as u8, (k >> 8) as u8);
    let r: u16 = hi + lo;
    if r > 0x7FFF { return 0x7FFF; }
    return r;
}

/// Signed (m · k) >> 8: m is a sin/cos value (|m| ≤ 256), k an unsigned
/// 8.8 factor. Saturates at ±0x7FFF.
fn m7k_smul_q8(m: i16, k: u16) -> i16 {
    let neg, mag = m7k_abs(m);
    let r: i16 = m7k_mul_q8(mag, k) as i16;
    if neg { return 0 - r; }
    return r;
}

/// WRMPYB ($4203) as a word: the low byte starts a multiply by the WRMPYA
/// already there; the high byte lands in WRDIVL ($4204), which starts
/// nothing.
#[hw(0x4203)]
static mut M7K_WRMPYB: u16;

/// `$out` = (t · d) >> 14 for magnitudes t ≤ 256 (8.8) and d (u16): two
/// 8×8 products, the second reusing WRMPYA.
macro_rules! m7k_tprod($t:expr, $d:expr, $out:ident) {
    if $t < 256 {
        WRMPY = $t | ($d << 8);
        NOP(4);
        let m7k_lo: u16 = RDMPY;
        M7K_WRMPYB = $d >> 8;
        NOP(4);
        $out = (RDMPY + (m7k_lo >> 8)) >> 6;
    } else {
        $out = $d >> 6;
    }
}

/// A 10.6 offset (dx, dy) turned into view space by a heading's sin and
/// cos (8.8), in whole texels: forward = -(s·dx + c·dy) >> 14 and right =
/// (c·dx - s·dy) >> 14, each product's magnitude truncated, then signed.
/// Eight hardware multiplies, no calls.
fn m7k_rotate14(s: i16, c: i16, dx: i16, dy: i16) -> i16, i16 {
    let sn, sm = m7k_abs(s);
    let cn, cm = m7k_abs(c);
    let xn, xm = m7k_abs(dx);
    let yn, ym = m7k_abs(dy);
    let mut sx: u16 = 0;
    let mut sy: u16 = 0;
    let mut cx: u16 = 0;
    let mut cy: u16 = 0;
    m7k_tprod!(sm, xm, sx);
    m7k_tprod!(sm, ym, sy);
    m7k_tprod!(cm, xm, cx);
    m7k_tprod!(cm, ym, cy);
    let mut psx: i16 = sx as i16;
    if sn != xn { psx = 0 - psx; }
    let mut psy: i16 = sy as i16;
    if sn != yn { psy = 0 - psy; }
    let mut pcx: i16 = cx as i16;
    if cn != xn { pcx = 0 - pcx; }
    let mut pcy: i16 = cy as i16;
    if cn != yn { pcy = 0 - pcy; }
    return 0 - psx - pcy, pcx - psy;
}

/// Signed i16 × i16, returned as bits 8..23 of the 32-bit product: a value
/// times an 8.8 factor.
fn m7k_smul_shr8(x: i16, y: i16) -> i16 {
    let xn, xm = m7k_abs(x);
    let yn, ym = m7k_abs(y);
    let lo, hi = mul16_wide(xm, ym);
    let r: i16 = ((hi << 8) | (lo >> 8)) as i16;
    if xn != yn { return 0 - r; }
    return r;
}

/// Signed i16 × i16, returned as bits 14..29 of the 32-bit product: the
/// `>> 14` that turns 8.8 × 10.6 into whole pixels.
fn m7k_smul_shr14(x: i16, y: i16) -> i16 {
    let xn, xm = m7k_abs(x);
    let yn, ym = m7k_abs(y);
    let lo, hi = mul16_wide(xm, ym);
    let r: i16 = ((hi << 2) | (lo >> 14)) as i16;
    if xn != yn { return 0 - r; }
    return r;
}

/// Signed i16 × i16, returned as bits 2..17 of the 32-bit product: 8.8 ×
/// pixels turned into 10.6 texels.
fn m7k_smul_shr2(x: i16, y: i16) -> i16 {
    let xn, xm = m7k_abs(x);
    let yn, ym = m7k_abs(y);
    let lo, hi = mul16_wide(xm, ym);
    let r: i16 = ((hi << 14) | (lo >> 2)) as i16;
    if xn != yn { return 0 - r; }
    return r;
}

// ============================================================================
// VRAM UPLOAD
// ============================================================================

/// The VRAM word address Mode 7's map and chr start at.
const M7K_VRAM0: u16 = 0;

/// Copies 32 KB of interleaved Mode 7 data (map in even bytes, chr in odd
/// bytes: an `.md7` file) to VRAM word 0 on DMA channel 0. Force blank.
macro_rules! mode7_upload_interleaved($data:ident) {
    dma_copy_vram_const!(0, $data, M7K_VRAM0, 32768);
}

/// Copies a 16 KB tilemap (128×128 tile numbers) to the low VRAM bytes and
/// 16 KB of chr (256 tiles × 64 bytes) to the high ones, on DMA channel 0.
/// Force blank.
macro_rules! mode7_upload_split($map:ident, $chr:ident) {
    VMAIN = 0x00;
    VMADD = 0;
    STATUS.A16 = false;   // dma_set_src! is m8 asm
    dma_set_src!(0, $map);
    dma_set_size!(0, 16384);
    dma_set_ppu_dest!(0, 0, 24);
    dma_trigger!(0);
    VMAIN = 0x80;
    VMADD = 0;
    STATUS.A16 = false;   // dma_set_src! is m8 asm
    dma_set_src!(0, $chr);
    dma_set_size!(0, 16384);
    dma_set_ppu_dest!(0, 0, 25);
    dma_trigger!(0);
}

// ============================================================================
// THE DEPTH SCALE
// ============================================================================
//
// The per-line views' shared table: `M7Plain` and `M7PlainRotation` both
// turn a 1/Z interpolant into a depth scale through it. Placed wherever it
// fits, not in the includer's bank: the bank the include restores comes
// back after this file.

/// The last `M7K_ZRECIP` index: the ramp's end, 32 lines past dizworld's
/// near edge, at height 0.
const M7K_ZRECIP_LAST: u16 = 2320;

const fn m7k_build_zrecip() -> [u8; 2321] {
    let mut t: [u8; 2321] = [0; 2321];
    t[0] = 255;
    for i in 1..2321 {
        let v: u16 = 32768 / (i as u16);
        if v > 255 { t[i] = 255; } else { t[i] = v as u8; }
    }
    return t;
}

#[bank(auto)]

/// min(255, 32768 / i): the depth scale z (64 a texel per pixel) for 1/Z
/// interpolant `zr >> 4`. `M7Plain`'s ramp runs 32 lines
/// (`M7K_PITCH_DOWN`) past 2^21 / 64, so the index stops at
/// `M7K_ZRECIP_LAST`; `M7PlainRotation` clamps to it.
far static M7K_ZRECIP: [u8; 2321] = m7k_build_zrecip();
