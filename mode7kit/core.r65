//! mode7kit core: the `Mode7` trait both modes implement, and the pieces
//! they share.
//!
//! A game picks a view by the type it uses: `M7Static` (`static.r65`), one
//! matrix a frame, or a perspective floor (`M7Floor`, `floor.r65`), one
//! matrix a scanline by HDMA, under a sky (`Horizon`) or in a split. Each
//! implements `Mode7`, so a game's loop and sprite code read the same in
//! any. This file holds the trait and `Mode7Scan`, the per-line views'
//! trait; the M7SEL enums, the sin/cos table, the world coordinate and the
//! camera (`M7Camera`, and `M7K_CAMERA`, the one every view follows until
//! its `set_camera`); two stateless register writers, the DMA channel
//! array, the fixed-point multiplies and the VRAM upload macros; and the
//! transport.
//!
//! The transport, `m7k_hdma!`, carries one Mode 7 matrix a scanline by
//! indirect HDMA: double-buffered per-line matrices, their indirect HDMA
//! tables, M7SEL and the view, and the HDMAEN shadow. It does no math: a
//! floor (`floor.r65`) or the game's own effect fills its rows, and
//! `commit()` shows them. The default instance is `M7HDMA` (state
//! `M7K_HDMA`): 224 lines on channels 2 (M7A/M7B) and 3 (M7C/M7D). A game
//! wanting fewer lines, other channels, or an effect of its own includes
//! this file and writes its own instance:
//!
//! ```
//! include!("mode7kit/core.r65")
//!
//! m7k_hdma!(Wavy, WAVY, 224, 1, 3);     // all 224 lines on channels 1 and 3
//!
//! Wavy::setup(M7Repeat::Wrap, M7Flip::None);   // force blank
//! loop {
//!     wait_nmi!();
//!     let mut l: u8 = 0;
//!     while l < 224 { Wavy::set_line(l, a, b, c, d); l++; }   // line l reads row l
//!     Wavy::set_center(cx, cy, hofs, vofs);
//!     Wavy::publish(0, 224);
//! }
//!
//! #[interrupt(nmi)]
//! fn vblank() { let _shown, _k = Wavy::commit(); }
//! ```
//!
//! A flat view:
//!
//! ```
//! include!("mode7kit/static.r65")
//!
//! M7Static::setup(M7Repeat::Wrap, M7Flip::None);   // in force blank
//! loop {
//!     wait_nmi!();
//!     M7K_CAMERA.turn(1);
//!     M7Static::update();
//!     let sx, sy, size = M7Static::to_screen(enemy_x, enemy_y);
//! }
//!
//! #[interrupt(nmi)]
//! fn vblank() { M7Static::nmi(); }
//! ```
//!
//! See DESIGN.md for the math and the cost model.

include!("stdlib/sneslib.r65")
include!("stdlib/math.r65")

// ============================================================================
// M7SEL
// ============================================================================

/// What the plane shows beyond its 1024×1024 texels (M7SEL bits 6-7).
enum M7Repeat {
    /// The whole 128×128 tilemap repeats forever in every direction.
    Wrap = 0x00,
    /// Nothing is drawn outside the map: the backdrop or a lower layer shows.
    Transparent = 0x80,
    /// Outside the map, tile 0's pattern repeats and the tilemap does not.
    Tile0 = 0xC0,
}

impl M7Repeat {
    /// True only for `Wrap`: the plane is a torus, so world coordinates
    /// wrap and every point is on the map.
    fn wraps(self) -> bool {
        return self as u8 == 0;
    }
}

/// Reflection of the screen (M7SEL bits 0-1). The hardware mirrors the
/// screen coordinate before the matrix applies: Sx becomes 255 - Sx, Sy
/// becomes 255 - Sy.
enum M7Flip {
    None = 0x00,
    Horizontal = 0x01,
    Vertical = 0x02,
    Both = 0x03,
}

impl M7Flip {
    /// True for `Horizontal` and `Both`.
    fn horizontal(self) -> bool {
        return self as u8 & 0x01 != 0;
    }

    /// True for `Vertical` and `Both`.
    fn vertical(self) -> bool {
        return self as u8 & 0x02 != 0;
    }

    /// The reflection with the horizontal axis switched.
    fn toggle_h(self) -> M7Flip {
        match self {
            M7Flip::None => M7Flip::Horizontal,
            M7Flip::Horizontal => M7Flip::None,
            M7Flip::Vertical => M7Flip::Both,
            M7Flip::Both => M7Flip::Vertical,
        }
    }

    /// The reflection with the vertical axis switched.
    fn toggle_v(self) -> M7Flip {
        match self {
            M7Flip::None => M7Flip::Vertical,
            M7Flip::Vertical => M7Flip::None,
            M7Flip::Horizontal => M7Flip::Both,
            M7Flip::Both => M7Flip::Horizontal,
        }
    }
}

// ============================================================================
// WORLD COORDINATES
// ============================================================================

/// A world coordinate: 10.6 fixed-point texels. `>> 6` is the texel,
/// `>> 9` the tile. The plane is 1024 texels, exactly 65536 sixty-fourths,
/// so it wraps by u16 overflow.
struct M7Coord(u16);

impl M7Coord {
    /// The coordinate of texel `t`.
    fn from_texel(t: u16) -> M7Coord {
        return M7Coord(t << 6);
    }

    /// The texel, 0..1023.
    fn texel(self) -> u16 {
        return (self.0 >> 6) & 0x3FF;
    }

    /// The tile, 0..127.
    fn tile(self) -> u8 {
        return (self.0 >> 9) as u8 & 0x7F;
    }
}

// ============================================================================
// SIN AND COS
// ============================================================================

// Angles are `u8`, 256 steps per turn. `M7K_SINCOS` is 640 bytes of ROM,
// dropped from a program that never turns.

const fn m7k_build_sincos() -> [i16; 320] {
    let mut t: [i16; 320] = [0; 320];
    for i in 0..320 {
        t[i] = fixed_sin(i as u16, 256, 256);
    }
    return t;
}

/// sin(2π·i/256)·256 for i in 0..320: `sin(a) = T[a]`, `cos(a) = T[a + 64]`.
static M7K_SINCOS: [i16; 320] = m7k_build_sincos();

/// sin(angle), 8.8 signed.
fn m7k_sin(angle: u8) -> i16 {
    return M7K_SINCOS[angle as u16];
}

/// cos(angle), 8.8 signed.
fn m7k_cos(angle: u8) -> i16 {
    return M7K_SINCOS[angle as u16 + 64];
}

/// One step forward along `angle`, as a 10.6 world delta: `speed` is in
/// 1/64 texel, so 64 moves one texel. Forward is -Y at angle 0, the way the
/// rotation matrix turns the view.
fn m7k_heading(angle: u8, speed: u8) -> i16, i16 {
    let dx: i16 = m7k_smul_q8(0 - m7k_sin(angle), speed as u16);
    let dy: i16 = m7k_smul_q8(0 - m7k_cos(angle), speed as u16);
    return dx, dy;
}

// ============================================================================
// THE CAMERA
// ============================================================================

/// a - b as a signed 10.6 distance: the shortest way round the plane,
/// within ±512 texels.
fn m7k_delta(a: M7Coord, b: M7Coord) -> i16 {
    return (a.0 - b.0) as i16;
}

/// The index of the tile under (x, y) in a 128×128 map, row by row. The
/// game reads its own map with it.
fn m7k_tile_index(x: M7Coord, y: M7Coord) -> u16 {
    return ((y.tile() as u16) << 7) | x.tile() as u16;
}

/// A world camera: the point a view is built around, and the way it faces
/// (256 per turn; 0 looks toward -Y). Declare more as `#[lowram] static
/// mut` for more views, and give each view its camera with
/// `Mode7::set_camera`.
struct M7Camera {
    x: M7Coord,
    y: M7Coord,
    angle: u8,
}

/// The camera every view follows until its `set_camera`.
#[lowram]
static mut M7K_CAMERA: M7Camera = M7Camera {
    x: M7Coord(0x8000), y: M7Coord(0x8000), angle: 0,
};

impl M7Camera {
    /// Places the camera.
    fn set(*self, x: M7Coord, y: M7Coord) {
        self.x = x;
        self.y = y;
    }

    /// Where the camera is.
    fn get(*self) -> M7Coord, M7Coord {
        return self.x, self.y;
    }

    /// Faces the camera along `angle`.
    fn set_angle(*self, angle: u8) {
        self.angle = angle;
    }

    /// The heading.
    fn angle(*self) -> u8 {
        return self.angle;
    }

    /// Turns by `d` steps; positive turns the view counterclockwise.
    fn turn(*self, d: i8) {
        self.angle = self.angle + d as u8;
    }

    /// Moves the camera by a 10.6 delta, such as `m7k_heading` gives.
    fn move_by(*self, dx: i16, dy: i16) {
        self.x = self.x + dx as u16;
        self.y = self.y + dy as u16;
    }

    /// Moves `speed` 1/64 texels along the heading (±255); negative moves
    /// back.
    fn forward(*self, speed: i16) {
        self.step(self.angle, speed);
    }

    /// Moves `speed` 1/64 texels across the heading, toward the screen's
    /// right (±255); negative moves left.
    fn strafe(*self, speed: i16) {
        self.step(self.angle - 64, speed);
    }

    /// `speed` along `angle`, the negative way round by a half turn.
    fn step(*self, angle: u8, speed: i16) {
        let mut a: u8 = angle;
        let mut s: i16 = speed;
        if s < 0 {
            a = a + 128;
            s = 0 - s;
        }
        let dx, dy = m7k_heading(a, s as u8);
        self.move_by(dx, dy);
    }
}

/// (x, y) 10.6 minus the whole-texel center (cx, cy) the registers show:
/// sprites then stay locked to the ground, not ahead of it by the fraction
/// the registers drop.
fn m7k_from_center(x: M7Coord, y: M7Coord, cx: u16, cy: u16) -> i16, i16 {
    let dx: i16 = (x.0 - (cx << 6)) as i16;
    let dy: i16 = (y.0 - (cy << 6)) as i16;
    return dx, dy;
}

/// Whether texel `center` plus the 10.6 offset `d` is on the map: always
/// when the plane `wraps`, else within 0..1023.
fn m7k_on_map(wraps: bool, center: u16, d: i16) -> bool {
    if wraps { return true; }
    let t: i16 = (center & 0x3FF) as i16 + (d >> 6);
    return t >= 0 && t < 1024;
}

// ============================================================================
// THE TRAIT
// ============================================================================

/// `to_screen`'s sy for a point that can't be drawn: behind the camera,
/// past the horizon or below the screen.
const M7K_HIDDEN: i16 = 0x7FFF;

/// Screen center, the usual pivot.
const M7_CENTER_X: u8 = 128;
const M7_CENTER_Y: u8 = 112;

/// A Mode 7 view: one implementor per way of feeding M7A-D. Every method
/// is an associated function on the implementing type (`M7Static::nmi()`),
/// dispatched statically; each implementor keeps its own state.
trait Mode7 {
    /// BGMODE 7, M7SEL, and the implementor's own hardware. Force blank,
    /// or vblank when switching modes.
    fn setup(repeat: M7Repeat, flip: M7Flip);

    /// The camera `update` builds from, from then on (`M7K_CAMERA` until
    /// called). The view keeps the pointer, not a copy: moving the camera
    /// moves the view.
    fn set_camera(cam: *M7Camera);

    /// The camera `update` builds from.
    fn camera() -> *M7Camera;

    /// Builds the next frame from the camera and the type's properties.
    fn update();

    /// Commits the built frame. Call from the NMI handler.
    fn nmi();

    /// The screen pixel showing world point (x, y), and the on-screen size
    /// of one texel there (8.8 pixels). sy is `M7K_HIDDEN` for a point that
    /// can't be drawn.
    fn to_screen(x: M7Coord, y: M7Coord) -> i16, i16, u16;

    /// The world point under screen pixel (sx, sy). The `bool` is false off
    /// the map under a repeat mode that doesn't wrap, or off the plane.
    fn to_world(sx: i16, sy: i16) -> bool, M7Coord, M7Coord;

    /// The implementor's M7SEL value (`M7Repeat as u8 | M7Flip as u8`),
    /// for the methods below.
    fn sel() -> u8;
    fn set_sel(sel: u8);

    /// Changes what is drawn beyond the map, keeping the reflection.
    fn set_repeat(repeat: M7Repeat) {
        Self::set_sel((Self::sel() & 0x03) | repeat as u8);
    }

    /// Changes the reflection, keeping the repeat mode.
    fn set_flip(flip: M7Flip) {
        Self::set_sel((Self::sel() & 0xC0) | flip as u8);
    }

    /// The current repeat mode.
    fn repeat() -> M7Repeat {
        return (Self::sel() & 0xC0) as M7Repeat;
    }

    /// The current reflection.
    fn flip() -> M7Flip {
        return (Self::sel() & 0x03) as M7Flip;
    }
}

// ============================================================================
// THE SCAN TRAIT
// ============================================================================

/// A `Mode7` view built a scanline at a time into a transport: a floor
/// (`m7k_floor!`) or a game's own per-line effect. A build renders rows
/// into a region of lines, `begin()..end()`; the lines above it, down from
/// the build's `top`, show the transport's top matrix. Presets stack these
/// by their regions: `m7k_horizon!` puts a band over the lines above the
/// region and `m7k_split!` builds two into one frame, through these
/// methods alone.
trait Mode7Scan: Mode7 {
    /// Builds `lines` lines from screen line `top` into the transport's
    /// back buffer, without publishing: the rows, the center and the
    /// scroll. A preset building several into one frame calls this for
    /// each, then lays out the segments itself.
    fn build(top: u8, lines: u8);

    /// Publishes the last full-screen `build` as the transport's next
    /// frame.
    fn publish();

    /// The transport's `commit()`, for a preset's `nmi()`: whether it
    /// flipped, and the buffer now shown.
    fn commit() -> bool, u8;

    /// The first screen line the last build rendered rows into.
    fn begin() -> u8;

    /// One past the last screen line the last build rendered rows into:
    /// the region is `begin()..end()`, empty when they are equal.
    fn end() -> u8;

    /// The last build's center (M7X, M7Y), in texels.
    fn center() -> u16, u16;

    /// The last build's BG1 scroll (M7HOFS, M7VOFS).
    fn scroll() -> u16, u16;
}

// ============================================================================
// REGISTER WRITERS
// ============================================================================

/// M7A..M7D, write-twice. In vblank.
fn m7k_write_matrix(a: i16, b: i16, c: i16, d: i16) {
    let ua: u16 = a as u16;
    M7A = ua as u8;
    M7A = (ua >> 8) as u8;
    let ub: u16 = b as u16;
    M7B = ub as u8;
    M7B = (ub >> 8) as u8;
    let uc: u16 = c as u16;
    M7C = uc as u8;
    M7C = (uc >> 8) as u8;
    let ud: u16 = d as u16;
    M7D = ud as u8;
    M7D = (ud >> 8) as u8;
}

/// M7SEL, the M7X/M7Y center and the BG1 scroll (M7HOFS/M7VOFS). In vblank.
fn m7k_write_view(sel: u8, cx: u16, cy: u16, hofs: u16, vofs: u16) {
    M7SEL = sel;
    M7X = cx as u8;
    M7X = (cx >> 8) as u8;
    M7Y = cy as u8;
    M7Y = (cy >> 8) as u8;
    BG1HOFS = hofs as u8;
    BG1HOFS = (hofs >> 8) as u8;
    BG1VOFS = vofs as u8;
    BG1VOFS = (vofs >> 8) as u8;
}

// ============================================================================
// DMA CHANNELS BY NUMBER
// ============================================================================

/// One DMA channel's registers, $43n0..$43nF.
struct M7KChannel {
    dmap: u8,
    bbad: u8,
    a1t: u16,
    a1b: u8,
    das: u16,
    dasb: u8,
    a2a: u16,
    ntrl: u8,
    unused: [u8; 5],
}

/// The eight channels. A constant index folds to one absolute store
/// (`M7K_DMA[3].a1t` is $4332), so an instance macro's channel numbers cost
/// nothing at run time.
#[hw(0x4300)]
static mut M7K_DMA: [M7KChannel; 8];

/// The bank of every `#[ram]` static: they are linked under `.BASE $7E`
/// (pinned by R65's tests/e2e/test_bank_byte_macros.py). Low RAM tables
/// are bank 0.
const M7K_RAM_BANK: u8 = 0x7E;

// ============================================================================
// FIXED-POINT HELPERS
// ============================================================================

/// Whether v is negative, and |v| as u16.
fn m7k_abs(v: i16) -> bool, u16 {
    if v < 0 {
        return true, (0 - v) as u16;
    }
    return false, v as u16;
}

/// (m · k) >> 8 for m ≤ 256 and any u16 k, saturating at 0x7FFF. Two 8×8
/// hardware multiplies: the high byte of k times m, plus the carry from
/// its low byte.
fn m7k_mul_q8(m: u16, k: u16) -> u16 {
    if m >= 256 {
        if k > 0x7FFF { return 0x7FFF; }
        return k;
    }
    let lo: u16 = mul8(m as u8, k as u8) >> 8;
    let hi: u16 = mul8(m as u8, (k >> 8) as u8);
    let r: u16 = hi + lo;
    if r > 0x7FFF { return 0x7FFF; }
    return r;
}

/// Signed (m · k) >> 8: m is a sin/cos value (|m| ≤ 256), k an unsigned
/// 8.8 factor. Saturates at ±0x7FFF.
fn m7k_smul_q8(m: i16, k: u16) -> i16 {
    let neg, mag = m7k_abs(m);
    let r: i16 = m7k_mul_q8(mag, k) as i16;
    if neg { return 0 - r; }
    return r;
}

/// WRMPYB ($4203) as a word: the low byte starts a multiply by the WRMPYA
/// already there; the high byte lands in WRDIVL ($4204), which starts
/// nothing.
#[hw(0x4203)]
static mut M7K_WRMPYB: u16;

/// `$out` = (t · d) >> 14 for magnitudes t ≤ 256 (8.8) and d (u16): two
/// 8×8 products, the second reusing WRMPYA.
macro_rules! m7k_tprod($t:expr, $d:expr, $out:ident) {
    if $t < 256 {
        WRMPY = $t | ($d << 8);
        NOP(4);
        let m7k_lo: u16 = RDMPY;
        M7K_WRMPYB = $d >> 8;
        NOP(4);
        $out = (RDMPY + (m7k_lo >> 8)) >> 6;
    } else {
        $out = $d >> 6;
    }
}

/// A 10.6 offset (dx, dy) turned into view space by a heading's sin and
/// cos (8.8), in whole texels: forward = -(s·dx + c·dy) >> 14 and right =
/// (c·dx - s·dy) >> 14, each product's magnitude truncated, then signed.
/// Eight hardware multiplies, no calls.
fn m7k_rotate14(s: i16, c: i16, dx: i16, dy: i16) -> i16, i16 {
    let sn, sm = m7k_abs(s);
    let cn, cm = m7k_abs(c);
    let xn, xm = m7k_abs(dx);
    let yn, ym = m7k_abs(dy);
    let mut sx: u16 = 0;
    let mut sy: u16 = 0;
    let mut cx: u16 = 0;
    let mut cy: u16 = 0;
    m7k_tprod!(sm, xm, sx);
    m7k_tprod!(sm, ym, sy);
    m7k_tprod!(cm, xm, cx);
    m7k_tprod!(cm, ym, cy);
    let mut psx: i16 = sx as i16;
    if sn != xn { psx = 0 - psx; }
    let mut psy: i16 = sy as i16;
    if sn != yn { psy = 0 - psy; }
    let mut pcx: i16 = cx as i16;
    if cn != xn { pcx = 0 - pcx; }
    let mut pcy: i16 = cy as i16;
    if cn != yn { pcy = 0 - pcy; }
    return 0 - psx - pcy, pcx - psy;
}

/// Signed i16 × i16, returned as bits 8..23 of the 32-bit product: a value
/// times an 8.8 factor.
fn m7k_smul_shr8(x: i16, y: i16) -> i16 {
    let xn, xm = m7k_abs(x);
    let yn, ym = m7k_abs(y);
    let lo, hi = mul16_wide(xm, ym);
    let r: i16 = ((hi << 8) | (lo >> 8)) as i16;
    if xn != yn { return 0 - r; }
    return r;
}

/// Signed i16 × i16, returned as bits 14..29 of the 32-bit product: the
/// `>> 14` that turns 8.8 × 10.6 into whole pixels.
fn m7k_smul_shr14(x: i16, y: i16) -> i16 {
    let xn, xm = m7k_abs(x);
    let yn, ym = m7k_abs(y);
    let lo, hi = mul16_wide(xm, ym);
    let r: i16 = ((hi << 2) | (lo >> 14)) as i16;
    if xn != yn { return 0 - r; }
    return r;
}

/// Signed i16 × i16, returned as bits 2..17 of the 32-bit product: 8.8 ×
/// pixels turned into 10.6 texels.
fn m7k_smul_shr2(x: i16, y: i16) -> i16 {
    let xn, xm = m7k_abs(x);
    let yn, ym = m7k_abs(y);
    let lo, hi = mul16_wide(xm, ym);
    let r: i16 = ((hi << 14) | (lo >> 2)) as i16;
    if xn != yn { return 0 - r; }
    return r;
}

// ============================================================================
// VRAM UPLOAD
// ============================================================================

const M7K_VRAM0: u16 = 0;

/// Copies 32 KB of interleaved Mode 7 data (map in even bytes, chr in odd
/// bytes: an `.md7` file) to VRAM word 0 on DMA channel 0. Force blank.
macro_rules! mode7_upload_interleaved($data:ident) {
    dma_copy_vram_const!(0, $data, M7K_VRAM0, 32768);
}

/// Copies a 16 KB tilemap (128×128 tile numbers) to the low VRAM bytes and
/// 16 KB of chr (256 tiles × 64 bytes) to the high ones, on DMA channel 0.
/// Force blank.
macro_rules! mode7_upload_split($map:ident, $chr:ident) {
    VMAIN = 0x00;
    VMADD = 0;
    STATUS.A16 = false;   // dma_set_src! is m8 asm
    dma_set_src!(0, $map);
    dma_set_size!(0, 16384);
    dma_set_ppu_dest!(0, 0, 24);
    dma_trigger!(0);
    VMAIN = 0x80;
    VMADD = 0;
    STATUS.A16 = false;   // dma_set_src! is m8 asm
    dma_set_src!(0, $chr);
    dma_set_size!(0, 16384);
    dma_set_ppu_dest!(0, 0, 25);
    dma_trigger!(0);
}

// ============================================================================
// HDMA TABLE WRITERS
// ============================================================================
//
// An HDMA entry starts with a header byte: bit 7 clear is *once* (one unit
// is written on the entry's first line and the register holds it), bit 7
// set is *continuous* (a new unit every line). Bits 0-6 are the line count;
// mode7kit keeps it in 1..127. A 0 header ends the table.

/// Direct-mode once entries holding a one-byte `value` for `lines` lines,
/// split into blocks of at most 127. Returns the new cursor.
fn m7k_hdma_hold(t: far *u8, pos: u16, lines: u8, value: u8) -> u16 {
    let mut p: u16 = pos;
    let mut left: u8 = lines;
    while left > 127 {
        t[p] = 127;
        t[p + 1] = value;
        p = p + 2;
        left = left - 127;
    }
    if left > 0 {
        t[p] = left;
        t[p + 1] = value;
        p = p + 2;
    }
    return p;
}

/// Indirect-mode entries covering `lines` lines from the data at `addr`
/// (same bank as DASBn). A once entry holds the one unit at `addr`; a
/// continuous entry reads `unit` bytes per line, so a block after the first
/// starts 127 units further on. Returns the new cursor.
fn m7k_hdma_ind(t: far *u8, pos: u16, lines: u8, addr: u16, unit: u16, continuous: bool) -> u16 {
    let mut p: u16 = pos;
    let mut left: u8 = lines;
    let mut a: u16 = addr;
    let mut flag: u8 = 0;
    if continuous { flag = 0x80; }
    while left > 0 {
        let mut n: u8 = left;
        if n > 127 { n = 127; }
        t[p] = flag | n;
        t[p + 1] = a as u8;
        t[p + 2] = (a >> 8) as u8;
        p = p + 3;
        if continuous {
            a = a + mul8(n, unit as u8);
        }
        left = left - n;
    }
    return p;
}

/// Ends a table.
fn m7k_hdma_end(t: far *u8, pos: u16) {
    t[pos] = 0;
}

// ============================================================================
// THE TRANSPORT
// ============================================================================

/// One buffer's indirect table, per channel: room for 10 entries and the
/// end (the floor uses at most 4, a split screen 6).
const M7K_IND_BYTES: u16 = 32;

/// `$name`, a transport of `$lines` matrix rows per buffer (at most 224:
/// the most lines of the screen that read their own row) on channels
/// `$ch_ab` (M7A/M7B) and `$ch_cd` (M7C/M7D). Its state, the `#[ram]`
/// static `$state`, takes 16·lines + 151 bytes.
macro_rules! m7k_hdma($name:ident, $state:ident, $lines:expr, $ch_ab:expr, $ch_cd:expr) {
    /// A transport's state. Buffer k's rows start at element k·2·LINES of
    /// `ab` and `cd`: row l's A and B are `ab[base + 2l]` and `[+ 1]`, its C
    /// and D `cd[...]` the same. Buffer k's indirect tables start at byte
    /// k·M7K_IND_BYTES of `abi` and `cdi`.
    struct $name {
        /// M7SEL as the game set it. A floor frame is written without the
        /// vertical bit, which stays set here.
        sel: u8,
        /// M7X/M7Y and BG1HOFS/BG1VOFS for the frame being built,
        /// committed with its tables.
        cx: u16,
        cy: u16,
        hofs: u16,
        vofs: u16,
        /// The buffer being built, and whether it is finished.
        back: u8,
        ready: u8,
        /// HDMAEN shadow: the matrix channels while set up, and the game's.
        hdmaen: u8,
        /// The frame being built is a floor: drop M7SEL's vertical bit.
        floor: bool,
        /// The matrix lines outside the rows hold: the AB unit, then CD.
        top: [i16; 4],
        abi: [u8; 64],
        cdi: [u8; 64],
        ab: [i16; $lines * 4],
        cd: [i16; $lines * 4],
        /// Per buffer, bumped by every write a builder's keys can't see (a
        /// custom `publish`, `setup`): a builder keyed on it rebuilds.
        stamp: [u8; 2],
    }

    #[ram]
    static mut $state: $name = $name {
        sel: 0, cx: 0, cy: 0, hofs: 0, vofs: 0,
        back: 0, ready: 0, hdmaen: 0, floor: false,
        top: [0x100, 0, 0, 0x100],
        abi: [0; 64], cdi: [0; 64],
        ab: [0; $lines * 4], cd: [0; $lines * 4],
        stamp: [0, 0],
    };

    impl $name {
        /// The matrix rows, from the top of the screen.
        const LINES: u16 = $lines;

        /// BGMODE 7 and M7SEL; configures the two channels, fills both
        /// buffers with the top matrix so the first frames are valid, and
        /// adds the channels to the HDMAEN shadow. Force blank, or vblank
        /// when switching modes.
        fn setup(repeat: M7Repeat, flip: M7Flip) {
            BGMODE = BG::Mode7 as u8;
            $state.sel = repeat as u8 | flip as u8;
            M7SEL = $state.sel;
            M7K_DMA[$ch_ab].dmap = 0x43;           // indirect, two write-twice registers
            M7K_DMA[$ch_ab].bbad = 0x1B;           // M7A, M7B
            M7K_DMA[$ch_ab].a1t = &$state.abi as u16;
            M7K_DMA[$ch_ab].a1b = M7K_RAM_BANK;
            M7K_DMA[$ch_ab].dasb = M7K_RAM_BANK;   // the rows' bank
            M7K_DMA[$ch_cd].dmap = 0x43;
            M7K_DMA[$ch_cd].bbad = 0x1D;           // M7C, M7D
            M7K_DMA[$ch_cd].a1t = &$state.cdi as u16;
            M7K_DMA[$ch_cd].a1b = M7K_RAM_BANK;
            M7K_DMA[$ch_cd].dasb = M7K_RAM_BANK;
            $state.back = 0;
            let p: u16 = $name::seg_top(0, 224);
            $name::finish(p, false);
            $state.back = 1;
            let q: u16 = $name::seg_top(0, 224);
            $name::finish(q, false);
            $state.ready = 0;
            $state.stamp[0] = $state.stamp[0] + 1;
            $state.stamp[1] = $state.stamp[1] + 1;
            $state.hdmaen = $state.hdmaen | (1 << $ch_ab) | (1 << $ch_cd);
        }

        /// Takes the matrix channels out of the shadow and writes HDMAEN
        /// at once, as the handler no longer commits. In vblank.
        fn stop() {
            $state.hdmaen = $state.hdmaen & ~((1 << $ch_ab) | (1 << $ch_cd));
            $state.ready = 0;
            HDMAEN = $state.hdmaen;
        }

        /// Shows the frame `finish` ended, from the NMI handler: points the
        /// channels at its tables, flips, and writes M7SEL (without the
        /// vertical bit for a floor), the center and the scroll. A frame
        /// not finished keeps the old one whole. Always writes HDMAEN; never
        /// M7A-D. Returns whether it flipped and the buffer now shown: an
        /// add-on that flipped points its own channels at that buffer.
        fn commit() -> bool, u8 {
            if $state.ready != 0 {
                let k: u8 = $state.back;
                let off: u16 = (k as u16) << 5;
                M7K_DMA[$ch_ab].a1t = (&$state.abi as u16) + off;
                M7K_DMA[$ch_cd].a1t = (&$state.cdi as u16) + off;
                $state.back = k ^ 1;
                $state.ready = 0;
                let mut sel: u8 = $state.sel;
                if $state.floor { sel = sel & 0xFD; }
                m7k_write_view(sel, $state.cx, $state.cy, $state.hofs, $state.vofs);
                HDMAEN = $state.hdmaen;
                return true, k;
            }
            HDMAEN = $state.hdmaen;
            return false, $state.back ^ 1;
        }

        /// M7SEL as set (`M7Repeat as u8 | M7Flip as u8`).
        fn sel() -> u8 {
            return $state.sel;
        }

        fn set_sel(sel: u8) {
            $state.sel = sel;
        }

        /// Adds the game's own HDMA channels to the HDMAEN shadow.
        fn enable(mask: u8) {
            $state.hdmaen = $state.hdmaen | mask;
        }

        /// Removes HDMAEN bits from the shadow.
        fn disable(mask: u8) {
            $state.hdmaen = $state.hdmaen & ~mask;
        }

        // -- the per-line layer -------------------------------------------

        /// The buffer being built, 0 or 1.
        fn back_index() -> u8 {
            return $state.back;
        }

        /// The back buffer's first element in `ab` / `cd` (0 or 2·LINES):
        /// row l's A and B are `$state.ab[back() + 2l]` and `[+ 1]`, its C
        /// and D `$state.cd[...]` the same.
        fn back() -> u16 {
            if $state.back != 0 { return $lines * 2; }
            return 0;
        }

        /// The back buffer's stamp, for a builder's keys.
        fn stamp() -> u8 {
            return $state.stamp[$state.back as u16];
        }

        /// Row `row` of the back buffer.
        fn set_line(row: u8, a: i16, b: i16, c: i16, d: i16) {
            let k: u16 = $name::back() + ((row as u16) << 1);
            $state.ab[k] = a;
            $state.ab[k + 1] = b;
            $state.cd[k] = c;
            $state.cd[k + 1] = d;
        }

        /// The matrix the lines outside the rows hold (the identity unless
        /// set).
        fn set_top(a: i16, b: i16, c: i16, d: i16) {
            $state.top[0] = a;
            $state.top[1] = b;
            $state.top[2] = c;
            $state.top[3] = d;
        }

        /// The center (texels) and the scroll for the frame being built.
        fn set_center(cx: u16, cy: u16, hofs: u16, vofs: u16) {
            $state.cx = cx;
            $state.cy = cy;
            $state.hofs = hofs;
            $state.vofs = vofs;
        }

        /// Finishes a custom frame: lines 0..top hold the top matrix, line
        /// `top + r` reads row r for `rows` lines, and the matrix channels
        /// stop after them (for a band below in another mode). The last
        /// step; `commit` shows it next vblank.
        fn publish(top: u8, rows: u8) {
            let p: u16 = $name::seg_top(0, top);
            let q: u16 = $name::seg_rows(p, 0, rows);
            $state.stamp[$state.back as u16] = $state.stamp[$state.back as u16] + 1;
            $name::finish(q, false);
        }

        /// Starts the back buffer's tables, for a frame of several bands:
        /// the first segment's cursor.
        fn begin() -> u16 {
            return 0;
        }

        /// A segment of `lines` lines holding the top matrix. Returns the
        /// next cursor.
        fn seg_top(p: u16, lines: u8) -> u16 {
            let base: u16 = ($state.back as u16) << 5;
            let ident: u16 = &$state.top as u16;
            m7k_hdma_ind(&$state.abi as far *u8, base + p, lines, ident, 4, false);
            let q: u16 = m7k_hdma_ind(&$state.cdi as far *u8, base + p, lines, ident + 4, 4, false);
            return q - base;
        }

        /// A segment of `lines` lines reading rows `row`, `row + 1`...
        /// Returns the next cursor.
        fn seg_rows(p: u16, row: u8, lines: u8) -> u16 {
            let base: u16 = ($state.back as u16) << 5;
            let row: u16 = ($name::back() + ((row as u16) << 1)) << 1;
            let ab: u16 = (&$state.ab as u16) + row;
            let cd: u16 = (&$state.cd as u16) + row;
            m7k_hdma_ind(&$state.abi as far *u8, base + p, lines, ab, 4, true);
            let q: u16 = m7k_hdma_ind(&$state.cdi as far *u8, base + p, lines, cd, 4, true);
            return q - base;
        }

        /// Ends the back buffer's tables at cursor `p` and marks it ready.
        /// `floor`: written without M7SEL's vertical bit.
        fn finish(p: u16, floor: bool) {
            let base: u16 = ($state.back as u16) << 5;
            m7k_hdma_end(&$state.abi as far *u8, base + p);
            m7k_hdma_end(&$state.cdi as far *u8, base + p);
            $state.floor = floor;
            $state.ready = 1;
        }

        /// Marks the back buffer ready with the tables it holds: for a
        /// builder whose keys say they are the ones it would write.
        fn finish_same(floor: bool) {
            $state.floor = floor;
            $state.ready = 1;
        }
    }
}

// The default transport: all 224 lines, channels 2 and 3.
m7k_hdma!(M7HDMA, M7K_HDMA, 224, 2, 3);
