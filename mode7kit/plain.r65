//! mode7kit floor: a Mode Y perspective floor, one matrix a scanline.
//!
//! Includes `hdma.r65`, the default transport it builds into, and with it
//! `core.r65`, whose `M7K_ZRECIP` it reads. Adds the per-height tables
//! `M7K_ROW_*` (640 bytes). The floor's math is dizworld's (Brad
//! Smith), with its divisions moved to compile time.
//!
//! `m7k_plain!` writes a floor type implementing `Mode7Scan` (`core.r65`),
//! and so `Mode7`: it follows a camera, builds its rows into a transport
//! (`m7k_hdma!`), and projects. It reads the camera's height and takes its
//! pitch as a horizon shift in scanlines. The default instance is `M7Plain`
//! (state `M7K_PLAIN`) over `M7HDMA`, the whole screen. It follows the
//! camera its `setup` takes, the game's.
//!
//! ```
//! include!("mode7kit/plain.r65")
//!
//! #[lowram]
//! static mut CAMERA: M7Camera = M7Camera {
//!     x: M7Coord(0x8000), y: M7Coord(0x8000), heading: 0, height: 64, pitch: 0,
//! };
//!
//! M7Plain::setup(&CAMERA, M7Repeat::Wrap, M7Flip::None);    // force blank
//! loop {
//!     wait_nmi!();
//!     CAMERA.set_height(height);
//!     M7Plain::update();
//!     let sx, sy, size = M7Plain::to_screen(enemy_x, enemy_y);
//! }
//!
//! #[interrupt(nmi)]
//! fn vblank() { M7Plain::nmi(); }
//! ```
//!
//! The row builder drives the hardware multiplier directly: an NMI
//! handler running mid-frame must not use it (`mul8`, `div16`...).

include!("mode7kit/hdma.r65")

// ============================================================================
// COMPILE-TIME TABLES
// ============================================================================

/// How far the floor's pitch looks down and up, in scanlines.
const M7K_PITCH_DOWN: i8 = 32;
const M7K_PITCH_UP: i8 = 64;

/// The lines a perspective floor can cover: the whole screen, at the lowest
/// camera looking fully down.
const M7K_MAX_GROUND: u16 = 224;

/// floor(2^shift / d), by long division: 2^21 does not fit a u16.
const fn m7k_pow2_div(shift: u16, d: u16) -> u16 {
    let mut rem: u16 = 1;
    let mut q: u16 = 0;
    for _i in 0..shift {
        rem = rem << 1;
        q = q << 1;
        if rem >= d {
            rem = rem - d;
            q = q + 1;
        }
    }
    return q;
}

const fn m7k_sky(h: u16) -> u16 { return 32 + (h >> 1); }
const fn m7k_zr0(h: u16) -> u16 { return m7k_pow2_div(21, 384 + (h << 1)); }
const fn m7k_zr1(h: u16) -> u16 {
    let at_near: u16 = m7k_pow2_div(21, 64 + (h >> 1));
    let at_far: u16 = m7k_zr0(h);
    if at_near < at_far { return at_far; }
    return at_near;
}

const fn m7k_build_row_sky() -> [u8; 128] {
    let mut t: [u8; 128] = [0; 128];
    for h in 0..128 { t[h] = m7k_sky(h as u16) as u8; }
    return t;
}

const fn m7k_build_row_zr0() -> [u16; 128] {
    let mut t: [u16; 128] = [0; 128];
    for h in 0..128 { t[h] = m7k_zr0(h as u16); }
    return t;
}

const fn m7k_build_row_step() -> [u16; 128] {
    let mut t: [u16; 128] = [0; 128];
    for h in 0..128 {
        let ground: u16 = 224 - m7k_sky(h as u16);
        t[h] = (m7k_zr1(h as u16) - m7k_zr0(h as u16)) / ground;
    }
    return t;
}

/// Per camera height 0..127: the horizon scanline (32..95), 1/Z at the
/// horizon, and its step per ground line. dizworld's s0 = 384 + 2h and
/// s1 = 64 + h/2, divided at compile time.
static M7K_ROW_SKY: [u8; 128] = m7k_build_row_sky();
static M7K_ROW_ZR0: [u16; 128] = m7k_build_row_zr0();
static M7K_ROW_STEP: [u16; 128] = m7k_build_row_step();

// For every height the unpitched sky is 32..95 lines. Pitched, it is
// 0..159 and the ground 65..224: the ground fits M7K_MAX_GROUND.

// ============================================================================
// ROW BUILDERS
// ============================================================================
//
// A floor instance names its row builder, a macro expanded in its build:
// `$n` rows into transport state `$hstate` from element `$k`, reading the
// depth scales from floor state `$fstate`. `$c` and `$s` are |cos| and
// |sin| (8.8, ≤ 0x100); `$neg_c` and `$neg_s` their signs. Row l is
// A = D = ±(z·|cos|/2) >> 5, B = ±(z·|sin|/2) >> 5, C = -B, with
// z = line_z[l].

/// The row builder on the hardware multiplier: two 8×8 products a row.
/// The first is one `WRMPY` store of z and the cos byte; WRMPYA keeps
/// z, so the second is a store of the sin byte alone. One loop per sign
/// quadrant, so a row applies no sign masks.
macro_rules! m7k_rows_mul($hstate:ident, $fstate:ident, $k:expr, $n:expr, $c:expr, $s:expr, $neg_c:expr, $neg_s:expr) {
    // |cos|/2 and |sin|/2 (1.7) in WRMPYB's byte
    let m7k_cos_hi: u16 = ($c >> 1) << 8;
    let m7k_sin_b: u16 = $s >> 1;
    let m7k_k0: u16 = $k;
    let m7k_n: u16 = $n;
    if $neg_c {
        if $neg_s {
            m7k_rows_mul_q!($hstate, $fstate, m7k_k0, m7k_n, m7k_cos_hi, m7k_sin_b, 0 - ma, 0 - mb, mb);
        } else {
            m7k_rows_mul_q!($hstate, $fstate, m7k_k0, m7k_n, m7k_cos_hi, m7k_sin_b, 0 - ma, mb, 0 - mb);
        }
    } else {
        if $neg_s {
            m7k_rows_mul_q!($hstate, $fstate, m7k_k0, m7k_n, m7k_cos_hi, m7k_sin_b, ma, 0 - mb, mb);
        } else {
            m7k_rows_mul_q!($hstate, $fstate, m7k_k0, m7k_n, m7k_cos_hi, m7k_sin_b, ma, mb, 0 - mb);
        }
    }
}

/// One quadrant's loop: A = D = `$fa`, B = `$fb`, C = `$fc`, from the
/// magnitudes `ma` and `mb`. The A and D stores fill the multiplier's
/// 8-cycle wait for the second product.
macro_rules! m7k_rows_mul_q($hstate:ident, $fstate:ident, $k:ident, $n:ident, $ch:ident, $sh:ident, $fa:expr, $fb:expr, $fc:expr) {
    let mut m7k_k: u16 = $k;
    let m7k_end: u16 = $k + ($n << 1);
    let mut m7k_l: u16 = 0;
    while m7k_k < m7k_end {
        let z: u16 = $fstate.line_z[m7k_l] as u16;
        WRMPY = z | $ch;
        NOP(4);
        let ma: i16 = (RDMPY >> 5) as i16;
        M7K_WRMPYB = $sh;
        let a: i16 = $fa;
        $hstate.ab[m7k_k] = a;
        $hstate.cd[m7k_k + 1] = a;
        let mb: i16 = (RDMPY >> 5) as i16;
        $hstate.ab[m7k_k + 1] = $fb;
        $hstate.cd[m7k_k] = $fc;
        m7k_k = m7k_k + 2;
        m7k_l++;
    }
}

// ============================================================================
// THE FLOOR
// ============================================================================

/// `$name`, a floor following the camera its `setup` takes, building its
/// rows into transport `$hdma` (state
/// `$hstate`) with row builder `$rows` (`m7k_rows_mul`). Its state, the
/// `#[ram]` static `$state`, takes 716 bytes.
macro_rules! m7k_plain($name:ident, $state:ident, $hdma:ident, $hstate:ident, $rows:ident) {
    /// A floor's state.
    struct $name {
        /// The last build's band: its top line, its horizon (a screen
        /// line), its ground lines; the line tables' height and foot (lines
        /// from the horizon to the point under the camera, where the matrix
        /// pivots).
        top: u8,
        sky: u8,
        ground: u8,
        foot: u8,
        built_height: u8,
        /// The last build's heading's sin and cos, for the projections.
        sin: i16,
        cos: i16,
        /// Depth of the last `to_screen` point, texels: sort objects by it.
        depth: i16,
        /// The last build's center (texels) and scroll.
        cx: u16,
        cy: u16,
        hofs: u16,
        vofs: u16,
        /// Per ground line, counted down from the horizon: the depth scale
        /// z, and the forward distance (texels) the line's center shows.
        /// They depend on the height alone, not on the pitch.
        line_z: [u8; 224],
        line_dist: [i16; 224],
        /// What each transport buffer holds of this floor, so a build that
        /// would write the same skips it: its rows' heading, line-table
        /// generation, band top, row count and transport stamp, and its
        /// tables' horizon, ground lines, stamp and generation.
        key_angle: [u8; 2],
        key_gen: [u8; 2],
        key_top: [u8; 2],
        key_rows: [u8; 2],
        key_stamp: [u8; 2],
        key_sky: [u8; 2],
        key_ground: [u8; 2],
        key_tstamp: [u8; 2],
        /// The camera the build follows.
        camera: *M7Camera,
        /// A count of line-table rebuilds, for the keys; the screen line the
        /// matrix pivots on; and `to_screen`'s cull distance, the
        /// horizon's (texels).
        gen: u8,
        pivot: u16,
        reach: u16,
        key_tgen: [u8; 2],
    }

    #[ram]
    static mut $state: $name = $name {
        top: 0, sky: 0, ground: 0, foot: 0, built_height: 0xFF,
        sin: 0, cos: 0x100, depth: 0,
        cx: 0, cy: 0, hofs: 0, vofs: 0,
        line_z: [0; 224], line_dist: [0; 224],
        key_angle: [0, 0], key_gen: [0xFF, 0xFF], key_top: [0, 0], key_rows: [0, 0],
        key_stamp: [0, 0], key_sky: [0xFF, 0xFF], key_ground: [0, 0], key_tstamp: [0, 0],
        camera: 0 as *M7Camera,
        gen: 0, pivot: 0, reach: 0, key_tgen: [0xFF, 0xFF],
    };

    impl Mode7 for $name {
        /// The transport's setup (BGMODE 7, M7SEL and the matrix
        /// channels), following camera `cam`.
        fn setup(cam: *M7Camera, repeat: M7Repeat, flip: M7Flip) {
            $state.camera = cam;
            $hdma::setup(repeat, flip);
            $state.built_height = 0xFF;
            $state.key_gen[0] = 0xFF;
            $state.key_gen[1] = 0xFF;
            $state.key_sky[0] = 0xFF;
            $state.key_sky[1] = 0xFF;
        }

        fn set_camera(cam: *M7Camera) {
            $state.camera = cam;
        }

        fn camera() -> *M7Camera {
            return $state.camera;
        }

        /// Builds the floor over the whole transport from the camera (its
        /// position, heading, height and pitch), and publishes it.
        fn update() {
            $name::build(0, $hdma::LINES as u8);
            $name::publish();
        }

        /// Shows the frame `update` finished. Always writes HDMAEN.
        fn nmi() {
            let _flipped, _k = $hdma::commit();
        }

        /// The floor point (x, y) on screen, and the size of one texel
        /// there (8.8 pixels). sy is `M7K_HIDDEN` for a point behind the
        /// camera, past the horizon or below the band. Its depth, for
        /// sorting, is left for `depth()`. After the build in the same
        /// frame.
        fn to_screen(x: M7Coord, y: M7Coord) -> i16, i16, u16 {
            m7k_scan_to_screen!($state, $hstate, x, y);
        }

        /// The floor point under screen pixel (sx, sy). The `bool` is false
        /// above the horizon, below the band, more than 128 pixels from the
        /// center column, or off the map under a repeat mode that doesn't
        /// wrap. After the build in the same frame.
        fn to_world(sx: i16, sy: i16) -> bool, M7Coord, M7Coord {
            let cx: u16 = $state.cx;
            let cy: u16 = $state.cy;
            if sy < $state.sky as i16 || sy >= ($state.sky as u16 + $state.ground as u16) as i16 {
                return false, M7Coord(cx << 6), M7Coord(cy << 6);
            }
            let mut x: i16 = sx;
            if $hstate.sel & 0x01 != 0 { x = 255 - x; }
            let l: u8 = (sy as u8) - $state.sky;
            let z: u8 = $state.line_z[l as u16];
            // pixels × z/64 texels per pixel, in 10.6: pixels × z
            let xn, xm = m7k_abs(x - 128);
            if xm > 128 {
                return false, M7Coord(cx << 6), M7Coord(cy << 6);
            }
            let mut r: i16 = mul8(xm as u8, z) as i16;
            if xn { r = 0 - r; }
            let f: i16 = mul8($state.foot - l, z) as i16;
            let s: i16 = $state.sin;
            let c: i16 = $state.cos;
            let dx: i16 = m7k_smul_shr8(r, c) - m7k_smul_shr8(f, s);
            let dy: i16 = 0 - m7k_smul_shr8(r, s) - m7k_smul_shr8(f, c);
            let wraps: bool = $name::repeat().wraps();
            let on: bool = m7k_on_map(wraps, cx, dx) && m7k_on_map(wraps, cy, dy);
            return on, M7Coord((cx << 6) + dx as u16), M7Coord((cy << 6) + dy as u16);
        }

        fn sel() -> u8 {
            return $hdma::sel();
        }

        fn set_sel(sel: u8) {
            $hdma::set_sel(sel);
        }
    }

    impl $name {
        /// Leaves the floor: the transport's stop, which turns its
        /// channels off at once. In vblank, straight after `wait_nmi!()`.
        fn stop() {
            $hdma::stop();
        }

        /// The depth of the last `to_screen` point, in texels.
        fn depth() -> i16 {
            return $state.depth;
        }

        // -- tables -------------------------------------------------------

        /// The per-line depth tables for camera height `h`, down from the
        /// horizon to the foot (the most lines a full look down shows):
        /// z(l), and the distance z(l)·(foot - l)/64 straight ahead on
        /// line l.
        fn rebuild_lines(h: u8) {
            let foot: u8 = (224 - M7K_ROW_SKY[h as u16]) + M7K_PITCH_DOWN as u8;
            let step: u16 = M7K_ROW_STEP[h as u16];
            let mut zr: u16 = M7K_ROW_ZR0[h as u16];
            // the distance's multiply is z times the lines left to the
            // foot, counted down in WRMPYB's byte
            let mut left: u16 = (foot as u16) << 8;
            let mut l: u16 = 0;
            while l < foot as u16 {
                let mut zi: u16 = zr >> 4;
                if zi > M7K_ZRECIP_LAST { zi = M7K_ZRECIP_LAST; }
                let z: u16 = M7K_ZRECIP[zi] as u16;
                WRMPY = z | left;
                $state.line_z[l] = z as u8;
                zr = zr + step;
                left = left - 0x100;
                $state.line_dist[l] = (RDMPY >> 6) as i16;
                l++;
            }
            $state.foot = foot;
            $state.built_height = h;
            $state.reach = $state.line_dist[0] as u16;
            $state.gen = $state.gen + 1;
        }
    }

    impl Mode7Scan for $name {
        /// The last build's horizon, a screen line: its rows start there.
        fn begin() -> u8 {
            return $state.sky;
        }

        /// The bottom of the last build's band.
        fn end() -> u8 {
            return $state.sky + $state.ground;
        }

        /// The ground lines: one row a line, from row `top`.
        fn segment(p: u16) -> u16 {
            return $hdma::seg_rows(p, $state.top, $state.ground);
        }

        /// The last build's center (M7X, M7Y), in texels.
        fn center() -> u16, u16 {
            return $state.cx, $state.cy;
        }

        /// The last build's BG1 scroll (M7HOFS, M7VOFS).
        fn scroll() -> u16, u16 {
            return $state.hofs, $state.vofs;
        }

        /// Builds the band of `lines` lines from screen line `top` into the
        /// transport's back buffer, without publishing: the horizon (its
        /// sky, clamped to the band), the ground rows (rows `top`...), the
        /// center and the scroll. A shorter band shows the top of the
        /// full-screen floor, cropped. Rows the buffer already holds for
        /// the same heading and height are kept.
        fn build(top: u8, lines: u8) {
            let cam: *M7Camera = $state.camera;
            let mut h: u8 = cam.height;
            if h > 127 { h = 127; }
            if h != $state.built_height {
                $name::rebuild_lines(h);
            }
            // the pitch, in scanlines, moves the floor's picture: only the
            // split and the pivot
            let mut tilt: i8 = cam.pitch;
            if tilt < 0 - M7K_PITCH_DOWN { tilt = 0 - M7K_PITCH_DOWN; }
            if tilt > M7K_PITCH_UP { tilt = M7K_PITCH_UP; }
            let mut sky: u8 = (M7K_ROW_SKY[h as u16] as i16 + tilt as i16) as u8;
            if sky > lines { sky = lines; }
            let horizon: u8 = top + sky;
            $state.top = top;
            $state.sky = horizon;
            $state.ground = lines - sky;

            // the pivot: the point under the camera, `foot` below the horizon
            $state.pivot = horizon as u16 + $state.foot as u16;
            m7k_scan_build_rows!($state, $hdma, $hstate, $rows, cam, top, $state.ground);
        }

        /// Publishes the last full-screen build: the lines above the
        /// horizon hold the transport's top matrix, the ground its rows.
        /// Tables the buffer already holds for the same split are kept.
        fn publish() {
            m7k_scan_publish!($name, $state, $hdma);
        }

        /// The transport's `commit()`, for an NMI handler that shows add-ons
        /// with the frame.
        fn commit() -> bool, u8 {
            let flipped, k = $hdma::commit();
            return flipped, k;
        }
    }
}

// The default floor: over `M7HDMA`, on the multiplier.
m7k_plain!(M7Plain, M7K_PLAIN, M7HDMA, M7K_HDMA, m7k_rows_mul);
