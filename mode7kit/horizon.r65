//! mode7kit horizon: a floor with a sky band in another BG mode above it,
//! an optional haze under the horizon, and an optional HUD band under the
//! floor.
//!
//! Includes `floor.r65` and `bands.r65`. `m7k_horizon!` writes a preset
//! implementing `Mode7` over a floor (`m7k_floor!`) and bands
//! (`m7k_bands!`): its bands are the sky, the floor and the HUD, the sky's
//! height following the floor's horizon each frame. The floor's own
//! properties stay on the floor (`M7Floor::set_height`).
//!
//! The default instance is `Horizon` (state `M7K_HORIZON`) over `M7Floor`
//! and `M7Bands`: HDMA channels 2-3 for the matrix, 4-6 for the bands.
//!
//! ```
//! include!("mode7kit/horizon.r65")
//!
//! Horizon::set_sky(0x01, 0x12, 0x11);   // Mode 1 sky: BG2+OBJ; floor: BG1+OBJ
//! Horizon::setup(M7Repeat::Wrap, M7Flip::None);
//! loop {
//!     wait_nmi!();
//!     Horizon::update();
//!     let sx, sy, size = Horizon::to_screen(enemy_x, enemy_y);
//! }
//!
//! #[interrupt(nmi)]
//! fn vblank() {
//!     Horizon::nmi();
//!     let hofs, vofs = Horizon::sky_scroll();   // the game's BG2 scroll
//! }
//! ```

include!("mode7kit/floor.r65")
include!("mode7kit/bands.r65")

/// `$name`, floor `$floor` with bands `$bands` (at least 3 bands for a HUD,
/// a COLDATA channel for the haze). Its state, the `#[lowram]` static
/// `$state`, takes 15 bytes.
macro_rules! m7k_horizon($name:ident, $state:ident, $floor:ident, $bands:ident) {
    /// The split's configuration, and the sky scroll of the frame built
    /// and the frame shown.
    struct $name {
        sky_mode: u8,
        sky_tm: u8,
        ground_tm: u8,
        haze: bool,
        /// The HUD band's lines (0: none), BGMODE and TM.
        hud: u8,
        hud_mode: u8,
        hud_tm: u8,
        /// The sky layer's scroll for the frame being built...
        next_hofs: u16,
        next_vofs: u16,
        /// ...and for the one on screen, which `sky_scroll` returns.
        hofs: u16,
        vofs: u16,
    }

    #[lowram]
    static mut $state: $name = $name {
        sky_mode: 0x01, sky_tm: 0x02, ground_tm: 0x01, haze: false,
        hud: 0, hud_mode: 0x01, hud_tm: 0x04,
        next_hofs: 0, next_vofs: 176, hofs: 0, vofs: 176,
    };

    impl $name {
        /// The BGMODE byte above the horizon (0x01: Mode 1), and the
        /// main-screen layers (TM) on each side. Before `setup`.
        fn set_sky(sky_mode: u8, sky_tm: u8, ground_tm: u8) {
            $state.sky_mode = sky_mode;
            $state.sky_tm = sky_tm;
            $state.ground_tm = ground_tm;
        }

        /// With `on`, colour math adds a fading fixed colour to BG1 just
        /// under the horizon. Before `setup`.
        fn set_haze(on: bool) {
            $state.haze = on;
        }

        /// A band of `lines` lines at the bottom of the screen with its own
        /// BGMODE and TM, for a HUD (0 lines: none). The floor stops above
        /// it. Before `setup`.
        fn set_hud(lines: u8, mode: u8, tm: u8) {
            $state.hud = lines;
            $state.hud_mode = mode;
            $state.hud_tm = tm;
        }

        /// The sky layer's scroll for the frame on screen: horizontal
        /// parallax that turns with the view, and the vertical offset that
        /// puts the bottom of a 240-line sky on the horizon. Call from the
        /// NMI handler, after `nmi()`.
        fn sky_scroll() -> u16, u16 {
            return $state.hofs, $state.vofs;
        }
    }

    impl Mode7 for $name {
        /// The floor's setup, then the bands: the sky split at line 64, the
        /// floor, the HUD.
        fn setup(repeat: M7Repeat, flip: M7Flip) {
            $floor::setup(repeat, flip);
            let hud: u8 = $state.hud;
            $bands::set_band(0, 64, $state.sky_mode, $state.sky_tm);
            $bands::set_band(1, 160 - hud, 0x07, $state.ground_tm);
            if hud != 0 {
                $bands::set_band(2, hud, $state.hud_mode, $state.hud_tm);
                $bands::set_count(3);
            } else {
                $bands::set_count(2);
            }
            if $state.haze { $bands::set_haze(1); } else { $bands::set_haze(M7K_NO_HAZE); }
            $bands::setup();
        }

        /// The bands' stop, then the floor's. BGMODE, TM and COLDATA keep
        /// the last values their tables wrote.
        fn stop() {
            $bands::stop();
            $floor::stop();
        }

        /// The floor's build over the lines above the HUD, the bands at
        /// its horizon, then publish.
        fn update() {
            $floor::build(0, 224 - $state.hud);
            $bands::set_lines(0, $floor::sky());
            $bands::set_lines(1, $floor::ground());
            $bands::fill_back();
            $state.next_hofs = (0 - (($floor::angle() as u16) << 2)) & 0x03FF;
            $state.next_vofs = 240 - $floor::sky() as u16;
            $floor::publish();
        }

        /// Commits the floor, and the bands and sky scroll with it.
        fn nmi() {
            let flipped, k = $floor::commit();
            if flipped {
                $bands::show(k);
                $state.hofs = $state.next_hofs;
                $state.vofs = $state.next_vofs;
            }
        }

        fn to_screen(x: M7Coord, y: M7Coord) -> i16, i16, u16 {
            let sx, sy, size = $floor::to_screen(x, y);
            return sx, sy, size;
        }

        fn to_world(sx: i16, sy: i16) -> bool, M7Coord, M7Coord {
            let on, wx, wy = $floor::to_world(sx, sy);
            return on, wx, wy;
        }

        fn sel() -> u8 {
            return $floor::sel();
        }

        fn set_sel(sel: u8) {
            $floor::set_sel(sel);
        }
    }
}

// The default preset: `M7Floor` with `M7Bands`.
m7k_horizon!(Horizon, M7K_HORIZON, M7Floor, M7Bands);
